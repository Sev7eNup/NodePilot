{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-07-22T22:00:00Z",
  "workflows": [
    {
      "name": "Nightly Host Health Check",
      "description": "Showcase workflow for the GitHub README - a scatter/gather pattern: a nightly schedule starts three probes of the NodePilot host (disk, services, event log) in parallel, a junction gathers them, an aggregation step turns their structured results into a verdict, and a decision routes to an ops alert or an all-green log before the run returns a structured nightly report. To cover other hosts, give each probe a targetMachineId.",
      "definition": {
        "nodes": [
          {
            "id": "trig",
            "type": "activity",
            "position": {
              "x": 80,
              "y": 40
            },
            "data": {
              "label": "Schedule: nightly 02:00",
              "activityType": "scheduleTrigger",
              "outputVariable": "trig",
              "config": {
                "cronExpression": "0 0 2 * * ? *",
                "description": "Nightly host health check, every night at 02:00"
              }
            }
          },
          {
            "id": "init",
            "type": "activity",
            "position": {
              "x": 80,
              "y": 240
            },
            "data": {
              "label": "runScript: Identify the probed host",
              "activityType": "runScript",
              "outputVariable": "init",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "# The probes below run on the NodePilot host itself. To check other hosts, give each probe a targetMachineId.\n$hostList = $env:COMPUTERNAME\nWrite-Output $hostList"
              }
            }
          },
          {
            "id": "logstart",
            "type": "activity",
            "position": {
              "x": 80,
              "y": 440
            },
            "data": {
              "label": "log: Run started",
              "activityType": "log",
              "outputVariable": "logstart",
              "config": {
                "level": "info",
                "message": "Nightly host health check started - host={{init.output}}"
              }
            }
          },
          {
            "id": "disk",
            "type": "activity",
            "position": {
              "x": 80,
              "y": 900
            },
            "data": {
              "label": "runScript: Disk capacity probe",
              "activityType": "runScript",
              "outputVariable": "disk",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "# fault below the free-space floor, unavailable when the drive cannot be read\n$minFreeGb = 10\ntry {\n  $drive = Get-PSDrive -Name C -PSProvider FileSystem -ErrorAction Stop\n  $freeGb = [math]::Round($drive.Free / 1GB, 1)\n  $diskState = if ($freeGb -ge $minFreeGb) { 'ok' } else { 'fault' }\n  $diskDetail = \"$freeGb GB free on C: (minimum $minFreeGb GB)\"\n} catch {\n  $diskState = 'unavailable'\n  $diskDetail = \"C: could not be read: $($_.Exception.Message)\"\n}\nWrite-Output $diskDetail"
              }
            }
          },
          {
            "id": "svc",
            "type": "activity",
            "position": {
              "x": 640,
              "y": 900
            },
            "data": {
              "label": "runScript: Service health probe",
              "activityType": "runScript",
              "outputVariable": "svc",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "# fault when a required service is not running, unavailable when one cannot be found\n$required = @('EventLog', 'Schedule', 'WinRM')\n$notRunning = @()\n$notFound = @()\nforeach ($name in $required) {\n  $service = Get-Service -Name $name -ErrorAction SilentlyContinue\n  if ($null -eq $service) { $notFound += $name }\n  elseif ($service.Status -ne 'Running') { $notRunning += \"$name is $($service.Status)\" }\n}\nif ($notFound.Count -gt 0) { $svcState = 'unavailable'; $svcDetail = \"not found: $($notFound -join ', ')\" }\nelseif ($notRunning.Count -gt 0) { $svcState = 'fault'; $svcDetail = $notRunning -join ', ' }\nelse { $svcState = 'ok'; $svcDetail = \"running: $($required -join ', ')\" }\nWrite-Output $svcDetail"
              }
            }
          },
          {
            "id": "evt",
            "type": "activity",
            "position": {
              "x": 1200,
              "y": 900
            },
            "data": {
              "label": "runScript: Event-log scan",
              "activityType": "runScript",
              "outputVariable": "evt",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "# fault on critical System events in the last 24 hours, unavailable when the log cannot be read\n$since = (Get-Date).AddHours(-24)\n$readError = $null\ntry {\n  $critical = @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; Level = 1; StartTime = $since } -ErrorAction Stop)\n} catch {\n  # Get-WinEvent reports an empty result as an error.\n  if ($_.FullyQualifiedErrorId -notlike 'NoMatchingEventsFound*') { $readError = $_.Exception.Message }\n  $critical = @()\n}\nif ($readError) { $evtState = 'unavailable'; $evtDetail = \"System log could not be read: $readError\" }\nelseif ($critical.Count -gt 0) { $evtState = 'fault'; $evtDetail = \"$($critical.Count) critical event(s), latest id $($critical[0].Id) at $($critical[0].TimeCreated.ToString('s'))\" }\nelse { $evtState = 'ok'; $evtDetail = 'no critical events in the last 24 hours' }\nWrite-Output $evtDetail"
              }
            }
          },
          {
            "id": "jwait",
            "type": "activity",
            "position": {
              "x": 640,
              "y": 1160
            },
            "data": {
              "label": "junction: waitAll (3 probes)",
              "activityType": "junction",
              "outputVariable": "jwait",
              "config": {
                "mode": "waitAll"
              }
            }
          },
          {
            "id": "agg",
            "type": "activity",
            "position": {
              "x": 640,
              "y": 1360
            },
            "data": {
              "label": "runScript: Aggregate findings",
              "activityType": "runScript",
              "outputVariable": "agg",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "# A probe that did not complete is missing evidence, never a healthy result.\n$diskRan = {{disk.success}}\n$svcRan = {{svc.success}}\n$evtRan = {{evt.success}}\n$findings = @()\nif ($diskRan -ne 'true') { $findings += 'disk: probe did not complete' }\nelseif ({{disk.param.diskState}} -ne 'ok') { $findings += 'disk: ' + {{disk.param.diskDetail}} }\nif ($svcRan -ne 'true') { $findings += 'services: probe did not complete' }\nelseif ({{svc.param.svcState}} -ne 'ok') { $findings += 'services: ' + {{svc.param.svcDetail}} }\nif ($evtRan -ne 'true') { $findings += 'event log: probe did not complete' }\nelseif ({{evt.param.evtState}} -ne 'ok') { $findings += 'event log: ' + {{evt.param.evtDetail}} }\n$issuesFound = if ($findings.Count -gt 0) { 'true' } else { 'false' }\n$summary = if ($findings.Count -gt 0) { $findings -join ' | ' } else { 'disk, services and event log are healthy' }\nWrite-Output $summary"
              }
            }
          },
          {
            "id": "issues",
            "type": "activity",
            "position": {
              "x": 640,
              "y": 1560
            },
            "data": {
              "label": "decision: Issues found?",
              "activityType": "decision",
              "outputVariable": "issues",
              "config": {
                "cases": [
                  {
                    "name": "issues-found",
                    "condition": {
                      "type": "comparison",
                      "left": {
                        "kind": "variable",
                        "stepId": "agg",
                        "field": "param",
                        "paramName": "issuesFound"
                      },
                      "op": "==",
                      "right": {
                        "kind": "literal",
                        "value": "true"
                      }
                    }
                  },
                  {
                    "name": "all-green",
                    "condition": {
                      "type": "comparison",
                      "left": {
                        "kind": "variable",
                        "stepId": "agg",
                        "field": "param",
                        "paramName": "issuesFound"
                      },
                      "op": "==",
                      "right": {
                        "kind": "literal",
                        "value": "false"
                      }
                    }
                  }
                ],
                "defaultCaseName": "issues-found"
              }
            }
          },
          {
            "id": "alert",
            "type": "activity",
            "position": {
              "x": 240,
              "y": 1820
            },
            "data": {
              "label": "email: Alert ops team",
              "activityType": "emailNotification",
              "outputVariable": "alert",
              "config": {
                "to": "ops-team@example.com",
                "subject": "[NodePilot] Host health check needs attention",
                "isHtml": false,
                "body": "The nightly health check of {{init.output}} flagged an issue.\n\nFindings:\n{{agg.output}}\n\nInvestigate via the NodePilot operations cockpit."
              }
            }
          },
          {
            "id": "green",
            "type": "activity",
            "position": {
              "x": 1040,
              "y": 1820
            },
            "data": {
              "label": "log: All green",
              "activityType": "log",
              "outputVariable": "green",
              "config": {
                "level": "info",
                "message": "Health check of {{init.output}} passed - no action required. {{agg.output}}"
              }
            }
          },
          {
            "id": "jret",
            "type": "activity",
            "position": {
              "x": 640,
              "y": 2040
            },
            "data": {
              "label": "junction: waitAny",
              "activityType": "junction",
              "outputVariable": "jret",
              "config": {
                "mode": "waitAny"
              }
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 640,
              "y": 2240
            },
            "data": {
              "label": "returnData: Nightly report",
              "activityType": "returnData",
              "outputVariable": "ret",
              "config": {
                "data": {
                  "summary": "{{agg.output}}",
                  "issuesFound": "{{agg.param.issuesFound}}",
                  "host": "{{init.output}}",
                  "disk": "{{disk.output}}",
                  "services": "{{svc.output}}",
                  "events": "{{evt.output}}"
                }
              }
            }
          },
          {
            "id": "note1",
            "type": "stickyNote",
            "position": {
              "x": 40,
              "y": 20
            },
            "style": {
              "width": 480,
              "height": 620
            },
            "data": {
              "label": "Note",
              "activityType": "note",
              "disabled": true,
              "text": "Phase 1 · Start\n\nSchedule fires nightly, names the probed host and logs the run start. The probes run on the NodePilot host; give them a targetMachineId to check another host."
            }
          },
          {
            "id": "note2",
            "type": "stickyNote",
            "position": {
              "x": 40,
              "y": 860
            },
            "style": {
              "width": 1320,
              "height": 240
            },
            "data": {
              "label": "Note",
              "activityType": "note",
              "disabled": true,
              "text": "Phase 2 · Parallel probes (scatter)\n\nThree independent checks run concurrently — disk capacity, service health and critical System events. Each publishes ok, fault or unavailable."
            }
          },
          {
            "id": "note3",
            "type": "stickyNote",
            "position": {
              "x": 160,
              "y": 1340
            },
            "style": {
              "width": 1040,
              "height": 940
            },
            "data": {
              "label": "Note",
              "activityType": "note",
              "disabled": true,
              "text": "Phase 3 · Triage & report (gather + verdict)\n\nThe junction waits for all probes, aggregation turns their states into findings, the decision routes to an alert or an all-green log (missing evidence counts as an issue), a junction merges both paths, and the final step returns the nightly report."
            }
          }
        ],
        "edges": [
          {
            "id": "e_trig_init",
            "source": "trig",
            "target": "init",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_init_logstart",
            "source": "init",
            "target": "logstart",
            "type": "labeled",
            "data": {
              "label": "On Success",
              "condition": "init.success"
            }
          },
          {
            "id": "e_logstart_disk",
            "source": "logstart",
            "target": "disk",
            "type": "labeled",
            "data": {
              "label": "On Success",
              "condition": "logstart.success"
            }
          },
          {
            "id": "e_logstart_svc",
            "source": "logstart",
            "target": "svc",
            "type": "labeled",
            "data": {
              "label": "On Success",
              "condition": "logstart.success"
            }
          },
          {
            "id": "e_logstart_evt",
            "source": "logstart",
            "target": "evt",
            "type": "labeled",
            "data": {
              "label": "On Success",
              "condition": "logstart.success"
            }
          },
          {
            "id": "e_disk_jwait",
            "source": "disk",
            "target": "jwait",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_svc_jwait",
            "source": "svc",
            "target": "jwait",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_evt_jwait",
            "source": "evt",
            "target": "jwait",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_jwait_agg",
            "source": "jwait",
            "target": "agg",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_agg_issues",
            "source": "agg",
            "target": "issues",
            "type": "labeled",
            "data": {
              "label": "On Success",
              "condition": "agg.success"
            }
          },
          {
            "id": "e_issues_alert",
            "source": "issues",
            "target": "alert",
            "type": "labeled",
            "data": {
              "label": "case=issues-found",
              "conditionExpression": {
                "type": "comparison",
                "left": {
                  "kind": "variable",
                  "stepId": "issues",
                  "field": "param",
                  "paramName": "case"
                },
                "op": "==",
                "right": {
                  "kind": "literal",
                  "value": "issues-found"
                }
              }
            }
          },
          {
            "id": "e_issues_green",
            "source": "issues",
            "target": "green",
            "type": "labeled",
            "data": {
              "label": "case=all-green",
              "conditionExpression": {
                "type": "comparison",
                "left": {
                  "kind": "variable",
                  "stepId": "issues",
                  "field": "param",
                  "paramName": "case"
                },
                "op": "==",
                "right": {
                  "kind": "literal",
                  "value": "all-green"
                }
              }
            }
          },
          {
            "id": "e_alert_jret",
            "source": "alert",
            "target": "jret",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_green_jret",
            "source": "green",
            "target": "jret",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          },
          {
            "id": "e_jret_ret",
            "source": "jret",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always"
            }
          }
        ]
      }
    }
  ]
}
