            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-n1-n2",
            "source": "n1",
            "target": "n2",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-n2-big",
            "source": "n2",
            "target": "big",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-big-n3",
