{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] startProgram",
      "description": "Both wait modes, stdout and stderr capture, a non-zero exit code accepted through successExitCodes and an explicit working directory.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 2/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 2/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "prog: wait, exit 0, stdout",
              "activityType": "startProgram",
              "config": {
                "filePath": "C:\\Windows\\System32\\cmd.exe",
                "arguments": "/c echo suite-marker",
                "workingDirectory": "C:\\Windows\\System32",
                "waitForExit": true,
                "timeoutSeconds": 30,
                "successExitCodes": "0"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "prog: exit 3 accepted",
              "activityType": "startProgram",
              "config": {
                "filePath": "C:\\Windows\\System32\\cmd.exe",
                "arguments": "/c exit 3",
                "waitForExit": true,
                "timeoutSeconds": 30,
                "successExitCodes": "0,3"
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "prog: stderr capture",
              "activityType": "startProgram",
              "config": {
                "filePath": "C:\\Windows\\System32\\cmd.exe",
                "arguments": "/c echo oops 1>&2",
                "waitForExit": true,
                "timeoutSeconds": 30,
                "successExitCodes": "0"
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "prog: fire and forget",
              "activityType": "startProgram",
              "config": {
                "filePath": "C:\\Windows\\System32\\cmd.exe",
                "arguments": "/c echo background",
                "waitForExit": false,
                "timeoutSeconds": 30
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$stdout   = {{v0.param.stdout}}\n$exit0    = {{v0.param.exitCode}}\n$waited   = {{v0.param.waited}}\n$exit3    = {{v1.param.exitCode}}\n$stderr   = {{v2.param.stderr}}\n$bgPid    = {{v3.param.processId}}\n$bgWaited = {{v3.param.waited}}\n\nif ($stdout -notmatch 'suite-marker') { throw \"startProgram stdout: '$stdout'\" }\nif ($exit0 -ne '0') { throw \"startProgram exit code: '$exit0'\" }\nif ($waited -ne 'True' -and $waited -ne 'true') { throw \"waited flag: '$waited'\" }\nif ($exit3 -ne '3') { throw \"successExitCodes: expected exit 3 reported, got '$exit3'\" }\nif ($stderr -notmatch 'oops') { throw \"startProgram stderr: '$stderr'\" }\nif ([string]::IsNullOrWhiteSpace($bgPid)) { throw \"fire-and-forget returned no process id\" }\nif ($bgWaited -eq 'True' -or $bgWaited -eq 'true') { throw \"fire-and-forget should not report waited\" }\n$assertOk = 'startProgram'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "startProgram",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-janitor",
            "source": "trg",
            "target": "janitor",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
