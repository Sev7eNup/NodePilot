{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] trigger driver: event log",
      "description": "Writes one Application-log event per cadence and waits for the event log trigger to acknowledge it. Needs the suite's event source registered.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 22/30 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 22/30 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "poke",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Poke: write an Application event",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\nWrite-EventLog -LogName Application -Source 'NodePilot-TestSuite' -EventId 4242 `\n  -EntryType Information -Message \"NodePilot test suite probe cid=$cid\"\n$pokedEvent = $cid\n"
              },
              "outputVariable": "poke",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "settle",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Wait for the listener",
              "activityType": "delay",
              "config": {
                "seconds": 45
              },
              "outputVariable": "settle"
            }
          },
          {
            "id": "check",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "Collect the acknowledgement",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$ack = Join-Path (Join-Path 'C:\\Temp\\NP-TestSuite\\runtime\\acks' 'eventlog') $cid\nif (-not (Test-Path -LiteralPath $ack)) { throw \"the event log trigger did not acknowledge cid $cid\" }\n$acknowledged = 'eventlog'\n"
              },
              "outputVariable": "check",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$state = {{check.param.acknowledged}}\nif ($state -ne 'eventlog') { throw \"event log acknowledgement missing\" }\n$assertOk = 'trigger-driver-eventlog'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "trigger-driver-eventlog",
                  "asserted": "{{assert.success}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-cid",
            "source": "trg",
            "target": "cid",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cid-poke",
            "source": "cid",
            "target": "poke",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-poke-settle",
            "source": "poke",
            "target": "settle",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-settle-check",
            "source": "settle",
            "target": "check",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-check-assert",
            "source": "check",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
