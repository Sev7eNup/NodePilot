            "id": "v4",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "folderOp: copy",
              "activityType": "folderOperation",
              "config": {
                "operation": "copy",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold",
                "destination": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-copy"
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "folderOp: rename",
              "activityType": "folderOperation",
              "config": {
                "operation": "rename",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-copy",
                "newName": "fold-ren"
              },
              "outputVariable": "v5",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v6",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "folderOp: move",
              "activityType": "folderOperation",
              "config": {
                "operation": "move",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-ren",
                "destination": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-moved"
              },
              "outputVariable": "v6",
              "targetMachineId": "localhost"
