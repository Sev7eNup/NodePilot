  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] folderOperation",
      "description": "All seven operations including the nested create, both outcomes of exists and the list projection.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 2/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 2/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "folderOp: create",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "folderOp: create nested",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold\\deep\\deeper"
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "folderOp: exists (true)",
              "activityType": "folderOperation",
              "config": {
                "operation": "exists",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold"
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "folderOp: list",
              "activityType": "folderOperation",
