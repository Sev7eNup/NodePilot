            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "folderOp: exists (false)",
              "activityType": "folderOperation",
              "config": {
                "operation": "exists",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-ren"
              },
              "outputVariable": "v7",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v8",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "folderOp: delete",
              "activityType": "folderOperation",
              "config": {
                "operation": "delete",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-moved"
              },
              "outputVariable": "v8",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v9",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 500
            },
            "data": {
              "label": "folderOp: exists after delete",
              "activityType": "folderOperation",
              "config": {
                "operation": "exists",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\fold-moved"
              },
              "outputVariable": "v9",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$existsBase   = {{v2.param.exists}}\n$listCount    = {{v3.param.count}}\n$listItems    = {{v3.param.items}}\n$existsMoved  = {{v7.param.exists}}\n$goneAfterDel = {{v9.param.exists}}\n\nif ($existsBase -ne 'True' -and $existsBase -ne 'true') {\n  throw \"folderOperation exists after create: '$existsBase'\"\n}\nif ([int]$listCount -lt 1) { throw \"folderOperation list count: expected the nested child, got '$listCount'\" }\nif ($listItems -notmatch 'deep') { throw \"folderOperation list items: '$listItems'\" }\nif ($existsMoved -eq 'True' -or $existsMoved -eq 'true') {\n  throw \"folderOperation: the source should be gone after a move\"\n}\nif ($goneAfterDel -eq 'True' -or $goneAfterDel -eq 'true') {\n  throw \"folderOperation: the folder should be gone after delete\"\n}\n$assertOk = 'folderOperation'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 740
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "folderOperation",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
