          {
            "id": "check",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 980
            },
            "data": {
              "label": "Verify bytes on disk",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\n\nfunction Get-Head { param($name, $n) ,([IO.File]::ReadAllBytes((Join-Path $dir $name))[0..($n-1)]) }\n$utf8Head   = (Get-Head 'enc-utf8.txt' 3) -join ','\n$bomHead    = (Get-Head 'enc-utf8bom.txt' 3) -join ','\n$le16Head   = (Get-Head 'enc-16le.txt' 2) -join ','\n$be16Head   = (Get-Head 'enc-16be.txt' 2) -join ','\n$asciiHead  = (Get-Head 'enc-ascii.txt' 3) -join ','\n$bomText    = [IO.File]::ReadAllText((Join-Path $dir 'enc-utf8bom.txt'))\n$crlfRaw    = [IO.File]::ReadAllText((Join-Path $dir 'le-crlf.txt'))\n$lfRaw      = [IO.File]::ReadAllText((Join-Path $dir 'le-lf.txt'))\n$crlfHasCr  = if ($crlfRaw.Contains([string][char]13)) { 'yes' } else { 'no' }\n$lfHasCr    = if ($lfRaw.Contains([string][char]13)) { 'yes' } else { 'no' }\n$bakExists  = if (Test-Path -LiteralPath (Join-Path $dir 'edit.txt.bak')) { 'yes' } else { 'no' }\n$mainText   = [IO.File]::ReadAllText((Join-Path $dir 'edit.txt'))\n$onlyOnce   = ([regex]::Matches($mainText, 'only-once')).Count.ToString()\n$neverWritten = if ($mainText.Contains('never-written')) { 'yes' } else { 'no' }\n"
              },
              "outputVariable": "check",
              "targetMachineId": "localhost"
            }
