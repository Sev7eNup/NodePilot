          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 1220
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "$before_v0 = {{v0.param.linesBefore}}\n$after_v0  = {{v0.param.linesAfter}}\n$before_v1 = {{v1.param.linesBefore}}\n$after_v1  = {{v1.param.linesAfter}}\n$before_v2 = {{v2.param.linesBefore}}\n$after_v2  = {{v2.param.linesAfter}}\n$before_v3 = {{v3.param.linesBefore}}\n$after_v3  = {{v3.param.linesAfter}}\n$before_v4 = {{v4.param.linesBefore}}\n$after_v4  = {{v4.param.linesAfter}}\n$before_v5 = {{v5.param.linesBefore}}\n$after_v5  = {{v5.param.linesAfter}}\n$before_v6 = {{v6.param.linesBefore}}\n$after_v6  = {{v6.param.linesAfter}}\n$before_v7 = {{v7.param.linesBefore}}\n$after_v7  = {{v7.param.linesAfter}}\n$before_v8 = {{v8.param.linesBefore}}\n$after_v8  = {{v8.param.linesAfter}}\n$before_v9 = {{v9.param.linesBefore}}\n$after_v9  = {{v9.param.linesAfter}}\n$before_v10 = {{v10.param.linesBefore}}\n$after_v10  = {{v10.param.linesAfter}}\n$before_v11 = {{v11.param.linesBefore}}\n$after_v11  = {{v11.param.linesAfter}}\n$before_v12 = {{v12.param.linesBefore}}\n$after_v12  = {{v12.param.linesAfter}}\n$before_e0 = {{e0.param.linesBefore}}\n$after_e0  = {{e0.param.linesAfter}}\n$before_e1 = {{e1.param.linesBefore}}\n$after_e1  = {{e1.param.linesAfter}}\n$before_e2 = {{e2.param.linesBefore}}\n$after_e2  = {{e2.param.linesAfter}}\n$before_e3 = {{e3.param.linesBefore}}\n$after_e3  = {{e3.param.linesAfter}}\n$before_e4 = {{e4.param.linesBefore}}\n$after_e4  = {{e4.param.linesAfter}}\n$before_e5 = {{e5.param.linesBefore}}\n$after_e5  = {{e5.param.linesAfter}}\n$before_l0 = {{l0.param.linesBefore}}\n$after_l0  = {{l0.param.linesAfter}}\n$before_l1 = {{l1.param.linesBefore}}\n$after_l1  = {{l1.param.linesAfter}}\n$before_l2 = {{l2.param.linesBefore}}\n$after_l2  = {{l2.param.linesAfter}}\nif ([int]$after_v0 -ne [int]$before_v1) { throw \"v0 reported $after_v0 lines but v1 saw $before_v1\" }\nif ([int]$after_v1 -ne [int]$before_v2) { throw \"v1 reported $after_v1 lines but v2 saw $before_v2\" }\nif ([int]$after_v2 -ne [int]$before_v3) { throw \"v2 reported $after_v2 lines but v3 saw $before_v3\" }\nif ([int]$after_v3 -ne [int]$before_v4) { throw \"v3 reported $after_v3 lines but v4 saw $before_v4\" }\nif ([int]$after_v4 -ne [int]$before_v5) { throw \"v4 reported $after_v4 lines but v5 saw $before_v5\" }\nif ([int]$after_v5 -ne [int]$before_v6) { throw \"v5 reported $after_v5 lines but v6 saw $before_v6\" }\nif ([int]$after_v6 -ne [int]$before_v7) { throw \"v6 reported $after_v6 lines but v7 saw $before_v7\" }\nif ([int]$after_v7 -ne [int]$before_v8) { throw \"v7 reported $after_v7 lines but v8 saw $before_v8\" }\nif ([int]$after_v8 -ne [int]$before_v9) { throw \"v8 reported $after_v8 lines but v9 saw $before_v9\" }\nif ([int]$after_v9 -ne [int]$before_v10) { throw \"v9 reported $after_v9 lines but v10 saw $before_v10\" }\nif ([int]$after_v10 -ne [int]$before_v11) { throw \"v10 reported $after_v10 lines but v11 saw $before_v11\" }\nif ([int]$after_v11 -ne [int]$before_v12) { throw \"v11 reported $after_v11 lines but v12 saw $before_v12\" }\nif ([int]$after_e0 -lt 1) { throw \"e0 produced an empty file\" }\nif ([int]$after_e1 -lt 1) { throw \"e1 produced an empty file\" }\nif ([int]$after_e2 -lt 1) { throw \"e2 produced an empty file\" }\nif ([int]$after_e3 -lt 1) { throw \"e3 produced an empty file\" }\nif ([int]$after_e4 -lt 1) { throw \"e4 produced an empty file\" }\nif ([int]$after_e5 -lt 1) { throw \"e5 produced an empty file\" }\nif ([int]$after_l0 -lt 1) { throw \"l0 produced an empty file\" }\nif ([int]$after_l1 -lt 1) { throw \"l1 produced an empty file\" }\nif ([int]$after_l2 -lt 1) { throw \"l2 produced an empty file\" }\n\n$linesBefore = {{v0.param.linesBefore}}\n$linesAfter  = {{v0.param.linesAfter}}\n$encReported = {{e1.param.encoding}}\n$leReported  = {{l0.param.lineEnding}}\n$dryRun      = {{v12.param.dryRun}}\n$utf8Head    = {{check.param.utf8Head}}\n$bomHead     = {{check.param.bomHead}}\n$le16Head    = {{check.param.le16Head}}\n$be16Head    = {{check.param.be16Head}}\n$asciiHead   = {{check.param.asciiHead}}\n$bomText     = {{check.param.bomText}}\n$crlfHasCr   = {{check.param.crlfHasCr}}\n$lfHasCr     = {{check.param.lfHasCr}}\n$bakExists   = {{check.param.bakExists}}\n$onlyOnce    = {{check.param.onlyOnce}}\n$neverWritten = {{check.param.neverWritten}}\n\nif ([int]$linesAfter -ne ([int]$linesBefore + 1)) {\n  throw \"append should add exactly one line, went from $linesBefore to $linesAfter\"\n}\nif ($encReported -ne 'utf8-bom') { throw \"textFileEdit reported encoding '$encReported'\" }\nif ($leReported -ne 'crlf') { throw \"textFileEdit reported lineEnding '$leReported'\" }\nif ($dryRun -ne 'True' -and $dryRun -ne 'true') { throw \"dryRun flag not reported: '$dryRun'\" }\nif ($utf8Head -eq '239,187,191') { throw \"encoding utf8 must not write a BOM\" }\nif ($bomHead -ne '239,187,191') { throw \"encoding utf8-bom head was '$bomHead'\" }\nif ($le16Head -ne '255,254') { throw \"encoding utf16le head was '$le16Head'\" }\nif ($be16Head -ne '254,255') { throw \"encoding utf16be head was '$be16Head'\" }\nif ($asciiHead -eq '239,187,191') { throw \"encoding ascii must not write a BOM\" }\nif ($bomText -notmatch 'def') { throw \"encoding auto did not append to the BOM file\" }\nif ($crlfHasCr -ne 'yes') { throw \"lineEnding crlf produced no carriage return\" }\nif ($lfHasCr -ne 'no') { throw \"lineEnding lf leaked a carriage return\" }\nif ($bakExists -eq 'yes') { throw \"a dry run must not leave a backup behind\" }\nif ($neverWritten -ne 'no') { throw \"a dry run must not modify the file\" }\nif ([int]$onlyOnce -ne 1) { throw \"appendIfMissing wrote the line $onlyOnce times\" }\n$assertOk = 'textFileEdit'\n"
              },
