              "activityType": "registryOperation",
              "config": {
                "operation": "createKey",
                "keyPath": "HKCU:\\SOFTWARE\\NP-TestSuite\\{{cid.param.text}}"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
