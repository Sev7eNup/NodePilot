              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "registryOperation",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
