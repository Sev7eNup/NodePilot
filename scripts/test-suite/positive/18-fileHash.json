{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] fileHash",
      "description": "All five algorithms, the absent-algorithm default and a matching expected hash.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 3/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 3/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "seed",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "Seed: known content",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 20,
                "script": "$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\n$path = Join-Path $dir 'hash.txt'\n[IO.File]::WriteAllText($path, 'nodepilot')\n$knownSha256 = (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash\n"
              },
              "outputVariable": "seed",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "hash: SHA256",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt",
                "algorithm": "SHA256"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "hash: SHA1",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt",
                "algorithm": "SHA1"
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "hash: MD5",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt",
                "algorithm": "MD5"
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "hash: SHA384",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt",
                "algorithm": "SHA384"
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "hash: SHA512",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt",
                "algorithm": "SHA512"
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "hash: default algorithm",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt"
              },
              "outputVariable": "v5",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v6",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "hash: expected matches",
              "activityType": "fileHash",
              "config": {
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\hash.txt",
                "algorithm": "SHA256",
                "expected": "{{seed.param.knownSha256}}"
              },
              "outputVariable": "v6",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$sha256 = {{v0.param.hash}}\n$sha1   = {{v1.param.hash}}\n$md5    = {{v2.param.hash}}\n$sha384 = {{v3.param.hash}}\n$sha512 = {{v4.param.hash}}\n$dflt   = {{v5.param.hash}}\n$dfltAlg = {{v5.param.algorithm}}\n$match  = {{v6.param.match}}\n\nif ($sha256.Length -ne 64) { throw \"SHA256 length: $($sha256.Length)\" }\nif ($sha1.Length   -ne 40) { throw \"SHA1 length: $($sha1.Length)\" }\nif ($md5.Length    -ne 32) { throw \"MD5 length: $($md5.Length)\" }\nif ($sha384.Length -ne 96) { throw \"SHA384 length: $($sha384.Length)\" }\nif ($sha512.Length -ne 128) { throw \"SHA512 length: $($sha512.Length)\" }\nif ($dflt -ne $sha256) { throw \"the default algorithm should be SHA256\" }\nif ($dfltAlg -ne 'SHA256') { throw \"default algorithm reported as '$dfltAlg'\" }\nif ($match -ne 'True' -and $match -ne 'true') { throw \"fileHash expected-match flag: '$match'\" }\n$assertOk = 'fileHash'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "fileHash",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-janitor",
            "source": "trg",
            "target": "janitor",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-janitor-cid",
