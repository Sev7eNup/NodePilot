{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] trigger: schedule",
      "description": "The cadence itself is the test. Asserts the trigger hands firedAt and nextFireAt to the run, which only a scheduler-started execution carries.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 1/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 1/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "read",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Read the trigger's own parameters",
              "activityType": "log",
              "config": {
                "level": "info",
                "message": "fired={{trg.param.firedAt}} next={{trg.param.nextFireAt}}"
              },
              "outputVariable": "read"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$msg = {{read.param.message}}\n# These parameters only exist on a run the scheduler started; a manual run has none,\n# which is exactly why this workflow is judged from its cadence and not from -Once.\nif ($msg -match 'fired=\\s*next=') { throw \"scheduleTrigger emitted no firedAt: '$msg'\" }\nif ($msg -match '\\{\\{') { throw \"trigger parameters left unresolved: '$msg'\" }\n$assertOk = 'scheduleTrigger'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "scheduleTrigger",
                  "asserted": "{{assert.success}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-read",
            "source": "trg",
            "target": "read",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-read-assert",
            "source": "read",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
