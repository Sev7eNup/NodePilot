{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] fileOperation",
      "description": "All six operations in one lifecycle, including both outcomes of exists.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 1/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 1/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "fileOp: create",
              "activityType": "fileOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\a.txt"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "fileOp: exists (true)",
              "activityType": "fileOperation",
              "config": {
                "operation": "exists",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\a.txt"
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "fileOp: copy",
              "activityType": "fileOperation",
              "config": {
                "operation": "copy",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\a.txt",
                "destination": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\b.txt"
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "fileOp: rename",
              "activityType": "fileOperation",
              "config": {
                "operation": "rename",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\b.txt",
                "newName": "c.txt"
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "fileOp: move",
              "activityType": "fileOperation",
              "config": {
                "operation": "move",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\c.txt",
                "destination": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\d.txt"
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "fileOp: exists (false)",
              "activityType": "fileOperation",
              "config": {
                "operation": "exists",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\c.txt"
              },
              "outputVariable": "v5",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v6",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "fileOp: delete",
              "activityType": "fileOperation",
              "config": {
                "operation": "delete",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\d.txt"
              },
              "outputVariable": "v6",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v7",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "fileOp: exists after delete",
              "activityType": "fileOperation",
              "config": {
                "operation": "exists",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\d.txt"
              },
              "outputVariable": "v7",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$existsAfterCreate = {{v1.param.exists}}\n$existsAfterMove   = {{v5.param.exists}}\n$existsAfterDelete = {{v7.param.exists}}\n$copyDest = {{v2.param.destination}}\n$renamed  = {{v3.param.newPath}}\n\nif ($existsAfterCreate -ne 'True' -and $existsAfterCreate -ne 'true') {\n  throw \"fileOperation exists after create: '$existsAfterCreate'\"\n}\nif ($existsAfterMove -eq 'True' -or $existsAfterMove -eq 'true') {\n  throw \"fileOperation: the source should be gone after a move\"\n}\nif ($existsAfterDelete -eq 'True' -or $existsAfterDelete -eq 'true') {\n  throw \"fileOperation: the file should be gone after delete\"\n}\nif ($copyDest -notmatch 'b.txt') { throw \"fileOperation copy destination: '$copyDest'\" }\nif ($renamed -notmatch 'c.txt')  { throw \"fileOperation rename newPath: '$renamed'\" }\n$assertOk = 'fileOperation'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "fileOperation",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
