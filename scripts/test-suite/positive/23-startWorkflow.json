{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] startWorkflow",
      "description": "Both completion modes, the parameter round-trip through the child's returnData and the system outputs the activity always emits.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 2/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 2/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "startWf: wait + capture",
              "activityType": "startWorkflow",
              "config": {
                "workflowNameOrId": "[TestSuite] Child: Echo Item",
                "waitForCompletion": true,
                "parameters": {
                  "item": "sync",
                  "index": "0",
                  "extra": "carried"
                },
                "timeoutSeconds": 60
              },
              "outputVariable": "v0"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "startWf: fire and forget",
              "activityType": "startWorkflow",
              "config": {
                "workflowNameOrId": "[TestSuite] Child: Echo Item",
                "waitForCompletion": false,
                "parameters": {
                  "item": "async",
                  "index": "1"
                }
              },
              "outputVariable": "v1"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$item   = {{v0.param.item}}\n$extra  = {{v0.param.extra}}\n$echoed = {{v0.param.echoed}}\n$status = {{v0.param.__status}}\n$wfName = {{v0.param.__workflowName}}\n$asyncId = {{v1.param.__executionId}}\n\nif ($item -ne 'sync')    { throw \"startWorkflow parameter round-trip: got '$item'\" }\nif ($extra -ne 'carried') { throw \"startWorkflow extra parameter: got '$extra'\" }\nif ($echoed -ne 'yes')   { throw \"child returnData was not mirrored as param.*\" }\nif ($status -ne 'Succeeded') { throw \"startWorkflow __status: got '$status'\" }\nif ($wfName -notmatch 'Echo Item') { throw \"startWorkflow __workflowName: got '$wfName'\" }\nif ([string]::IsNullOrWhiteSpace($asyncId)) {\n  throw \"fire-and-forget should still return an execution id\"\n}\n$assertOk = 'startWorkflow'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "startWorkflow",
                  "asserted": "{{assert.success}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-v0",
            "source": "trg",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v0-v1",
            "source": "v0",
            "target": "v1",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v1-assert",
            "source": "v1",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
