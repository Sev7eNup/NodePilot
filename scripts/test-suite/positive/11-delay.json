  "workflows": [
    {
      "name": "[TestSuite] delay",
      "description": "Zero, a typical duration and the non-number fallback to the 5 s default.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 1/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 1/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "delay: 0s",
              "activityType": "delay",
              "config": {
                "seconds": 0
              },
              "outputVariable": "v0"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "delay: 2s",
              "activityType": "delay",
              "config": {
                "seconds": 2
              },
              "outputVariable": "v1"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "delay: non-number falls back",
              "activityType": "delay",
              "config": {
                "seconds": "3"
              },
              "outputVariable": "v2"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$zero     = {{v0.output}}\n$two      = {{v1.output}}\n$fallback = {{v2.output}}\nif ($zero -notmatch 'Delayed for 0 seconds') { throw \"delay 0: got '$zero'\" }\nif ($two  -notmatch 'Delayed for 2 seconds') { throw \"delay 2: got '$two'\" }\n# A JSON string is not a JSON number, so the executor falls back to its 5 s default.\nif ($fallback -notmatch 'Delayed for 5 seconds') { throw \"delay string fallback: got '$fallback'\" }\n$assertOk = 'delay'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "delay",
                  "asserted": "{{assert.success}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-v0",
            "source": "trg",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
