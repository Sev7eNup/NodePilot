            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v2-assert",
            "source": "v2",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
