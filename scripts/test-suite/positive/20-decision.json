                "script": "$d01 = {{d01.param.case}}\nif ($d01 -ne 'eq') { throw \"decision eq: expected eq, got '$d01'\" }\n$d02 = {{d02.param.case}}\nif ($d02 -ne 'ne') { throw \"decision ne: expected ne, got '$d02'\" }\n$d03 = {{d03.param.case}}\nif ($d03 -ne 'lt') { throw \"decision lt: expected lt, got '$d03'\" }\n$d04 = {{d04.param.case}}\nif ($d04 -ne 'gt') { throw \"decision gt: expected gt, got '$d04'\" }\n$d05 = {{d05.param.case}}\nif ($d05 -ne 'le') { throw \"decision le: expected le, got '$d05'\" }\n$d06 = {{d06.param.case}}\nif ($d06 -ne 'ge') { throw \"decision ge: expected ge, got '$d06'\" }\n$d07 = {{d07.param.case}}\nif ($d07 -ne 'contains') { throw \"decision contains: expected contains, got '$d07'\" }\n$d08 = {{d08.param.case}}\nif ($d08 -ne 'startsWith') { throw \"decision startsWith: expected startsWith, got '$d08'\" }\n$d09 = {{d09.param.case}}\nif ($d09 -ne 'endsWith') { throw \"decision endsWith: expected endsWith, got '$d09'\" }\n$d10 = {{d10.param.case}}\nif ($d10 -ne 'matches') { throw \"decision matches: expected matches, got '$d10'\" }\n$d11 = {{d11.param.case}}\nif ($d11 -ne 'isEmpty') { throw \"decision isEmpty: expected isEmpty, got '$d11'\" }\n$d12 = {{d12.param.case}}\nif ($d12 -ne 'isNotEmpty') { throw \"decision isNotEmpty: expected isNotEmpty, got '$d12'\" }\n$d13 = {{d13.param.case}}\nif ($d13 -ne 'isTrue') { throw \"decision isTrue: expected isTrue, got '$d13'\" }\n$d14 = {{d14.param.case}}\nif ($d14 -ne 'isFalse') { throw \"decision isFalse: expected isFalse, got '$d14'\" }\n$d15 = {{d15.param.case}}\nif ($d15 -ne 'andGroup') { throw \"decision andGroup: expected andGroup, got '$d15'\" }\n$d16 = {{d16.param.case}}\nif ($d16 -ne 'orGroup') { throw \"decision orGroup: expected orGroup, got '$d16'\" }\n$d17 = {{d17.param.case}}\nif ($d17 -ne 'notGroup') { throw \"decision notGroup: expected notGroup, got '$d17'\" }\n$d18 = {{d18.param.case}}\nif ($d18 -ne 'default') { throw \"decision neverMatches: expected default, got '$d18'\" }\n$d19 = {{d19.param.case}}\nif ($d19 -ne 'winner') { throw \"decision first-match-wins: got '$d19'\" }\n$matched = {{d01.param.matched}}\nif ($matched -ne 'true') { throw \"decision matched flag: got '$matched'\" }\n$assertOk = 'decision'\n"
              },
