              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "$op_eq = {{op_eq.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_eq)) { throw \"edge == did not run\" }\n$op_ne = {{op_ne.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_ne)) { throw \"edge != did not run\" }\n$op_lt = {{op_lt.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_lt)) { throw \"edge < did not run\" }\n$op_gt = {{op_gt.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_gt)) { throw \"edge > did not run\" }\n$op_le = {{op_le.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_le)) { throw \"edge <= did not run\" }\n$op_ge = {{op_ge.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_ge)) { throw \"edge >= did not run\" }\n$op_contains = {{op_contains.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_contains)) { throw \"edge contains did not run\" }\n$op_startsWith = {{op_startsWith.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_startsWith)) { throw \"edge startsWith did not run\" }\n$op_endsWith = {{op_endsWith.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_endsWith)) { throw \"edge endsWith did not run\" }\n$op_matches = {{op_matches.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_matches)) { throw \"edge matches did not run\" }\n$op_isEmpty = {{op_isEmpty.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_isEmpty)) { throw \"edge isEmpty did not run\" }\n$op_isNotEmpty = {{op_isNotEmpty.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_isNotEmpty)) { throw \"edge isNotEmpty did not run\" }\n$op_isTrue = {{op_isTrue.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_isTrue)) { throw \"edge isTrue did not run\" }\n$op_isFalse = {{op_isFalse.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_isFalse)) { throw \"edge isFalse did not run\" }\n$op_andGroup = {{op_andGroup.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_andGroup)) { throw \"edge group AND did not run\" }\n$op_orGroup = {{op_orGroup.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_orGroup)) { throw \"edge group OR did not run\" }\n$op_notGroup = {{op_notGroup.param.message}}\nif ([string]::IsNullOrWhiteSpace($op_notGroup)) { throw \"edge not did not run\" }\n$legacy = {{legacy_ok.param.message}}\nif ([string]::IsNullOrWhiteSpace($legacy)) { throw 'legacy .success edge did not run' }\n$assertOk = 'edge-conditions'\n"
              },
