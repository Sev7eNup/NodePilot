{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] jsonQuery",
      "description": "Both sources, both result modes, a JSONPath filter expression and the zero-match case.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 3/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 3/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "seed",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "Seed: doc.json",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 20,
                "script": "$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\n$path = Join-Path $dir 'doc.json'\nSet-Content -LiteralPath $path -Encoding utf8 -Value @'\n{\"items\":[{\"name\":\"alpha\",\"id\":1,\"active\":true},{\"name\":\"beta\",\"id\":2,\"active\":false},{\"name\":\"gamma\",\"id\":3,\"active\":true}]}\n'@\n$seeded = 'ok'\n"
              },
              "outputVariable": "seed",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "json: inline single",
              "activityType": "jsonQuery",
              "config": {
                "source": "inline",
                "content": "{\"items\":[{\"name\":\"alpha\",\"id\":1,\"active\":true},{\"name\":\"beta\",\"id\":2,\"active\":false},{\"name\":\"gamma\",\"id\":3,\"active\":true}]}",
                "jsonPath": "$.items[0].name",
                "resultMode": "single"
              },
              "outputVariable": "v0"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "json: inline all (wildcard)",
              "activityType": "jsonQuery",
              "config": {
                "source": "inline",
                "content": "{\"items\":[{\"name\":\"alpha\",\"id\":1,\"active\":true},{\"name\":\"beta\",\"id\":2,\"active\":false},{\"name\":\"gamma\",\"id\":3,\"active\":true}]}",
                "jsonPath": "$.items[*].name",
                "resultMode": "all"
              },
              "outputVariable": "v1"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "json: filter expression",
              "activityType": "jsonQuery",
              "config": {
                "source": "inline",
                "content": "{\"items\":[{\"name\":\"alpha\",\"id\":1,\"active\":true},{\"name\":\"beta\",\"id\":2,\"active\":false},{\"name\":\"gamma\",\"id\":3,\"active\":true}]}",
                "jsonPath": "$.items[?(@.active==true)].name",
                "resultMode": "all"
              },
              "outputVariable": "v2"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "json: no match",
              "activityType": "jsonQuery",
              "config": {
                "source": "inline",
                "content": "{\"items\":[{\"name\":\"alpha\",\"id\":1,\"active\":true},{\"name\":\"beta\",\"id\":2,\"active\":false},{\"name\":\"gamma\",\"id\":3,\"active\":true}]}",
                "jsonPath": "$.items[?(@.name=='delta')].name",
                "resultMode": "all"
              },
              "outputVariable": "v3"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "json: source file",
              "activityType": "jsonQuery",
              "config": {
                "source": "file",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\doc.json",
                "jsonPath": "$.items[*].id",
                "resultMode": "all"
              },
              "outputVariable": "v4"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$single = {{v0.param.result}}\n$all    = {{v1.param.result}}\n$allN   = {{v1.param.count}}\n$filter = {{v2.param.result}}\n$noneN  = {{v3.param.count}}\n$fileR  = {{v4.param.result}}\n\nif ($single -ne 'alpha') { throw \"jsonQuery single: expected alpha, got '$single'\" }\nif ([int]$allN -ne 3)    { throw \"jsonQuery wildcard count: expected 3, got '$allN'\" }\nif ($all -notmatch 'alpha' -or $all -notmatch 'gamma') { throw \"jsonQuery all: '$all'\" }\nif ($filter -notmatch 'alpha' -or $filter -notmatch 'gamma') {\n  throw \"jsonQuery filter should keep both active items: '$filter'\"\n}\nif ($filter -match 'beta') { throw \"jsonQuery filter leaked an inactive item: '$filter'\" }\nif ([int]$noneN -ne 0) { throw \"jsonQuery no-match count: expected 0, got '$noneN'\" }\nif ($fileR -notmatch '1' -or $fileR -notmatch '3') { throw \"jsonQuery from file: '$fileR'\" }\n$assertOk = 'jsonQuery'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "jsonQuery",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-janitor",
            "source": "trg",
            "target": "janitor",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-janitor-cid",
            "source": "janitor",
            "target": "cid",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cid-mkrun",
            "source": "cid",
            "target": "mkrun",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-mkrun-seed",
            "source": "mkrun",
            "target": "seed",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-seed-v0",
            "source": "seed",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v0-v1",
            "source": "v0",
            "target": "v1",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v1-v2",
            "source": "v1",
            "target": "v2",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v2-v3",
            "source": "v2",
            "target": "v3",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            },
            "sourceHandle": "bottom",
            "targetHandle": "top"
          },
          {
            "id": "e-v3-v4",
            "source": "v3",
            "target": "v4",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v4-cleanup",
            "source": "v4",
            "target": "cleanup",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cleanup-assert",
            "source": "cleanup",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
