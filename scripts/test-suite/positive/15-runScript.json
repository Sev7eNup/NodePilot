{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] runScript",
      "description": "Structured parameter capture, the runspace and Windows PowerShell engines, process isolation with its caps, native exit-code acceptance, transcript capture and all three retry backoffs.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 0/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 0/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "runScript: structured output",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "$hostName = $env:COMPUTERNAME\n$answer = '42'\nWrite-Output 'captured'\n"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "runScript: engine runspace",
              "activityType": "runScript",
              "config": {
                "engine": "runspace",
                "timeoutSeconds": 30,
                "script": "$engineUsed = 'runspace'\nWrite-Output 'runspace ok'\n"
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "runScript: engine powershell (5.1)",
              "activityType": "runScript",
              "config": {
                "engine": "powershell",
                "timeoutSeconds": 60,
                "script": "$psMajor = $PSVersionTable.PSVersion.Major.ToString()\nWrite-Output 'windows powershell ok'\n"
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "runScript: isolated + caps",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "isolated": true,
                "memoryLimitMb": 512,
                "maxProcesses": 8,
                "script": "$isolatedPid = $PID.ToString()\nWrite-Output 'isolated ok'\n"
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "runScript: successExitCodes 0,3",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "successExitCodes": "0,3",
                "script": "cmd /c exit 3\nWrite-Output 'native exit captured'\n"
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "runScript: transcript",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "transcript": true,
                "script": "Write-Output 'transcript line'\n$transcriptProbe = 'yes'\n"
              },
              "outputVariable": "v5",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v6",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "runScript: retry fixed",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "retry": {
                  "maxAttempts": 3,
                  "backoff": "fixed",
                  "initialDelayMs": 200,
                  "maxDelayMs": 1000
                },
                "script": "$retried = 'ok'\nWrite-Output 'retry block accepted'\n"
              },
              "outputVariable": "v6",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v7",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "runScript: retry linear",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "retry": {
                  "maxAttempts": 2,
                  "backoff": "linear",
                  "initialDelayMs": 200
                },
                "script": "Write-Output 'linear'\n"
              },
              "outputVariable": "v7",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v8",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "runScript: retry exponential",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "retry": {
                  "maxAttempts": 2,
                  "backoff": "exponential",
                  "initialDelayMs": 200,
                  "maxDelayMs": 2000
                },
                "script": "Write-Output 'exponential'\n"
              },
              "outputVariable": "v8",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$hostName = {{v0.param.hostName}}\n$answer   = {{v0.param.answer}}\n$runspace = {{v1.param.engineUsed}}\n$psMajor  = {{v2.param.psMajor}}\n$isoOut   = {{v3.output}}\n$exit3    = {{v4.param.exitCode}}\n$transcr  = {{v5.output}}\n$retried  = {{v6.param.retried}}\n$linear   = {{v7.output}}\n$expo     = {{v8.output}}\n\nif ([string]::IsNullOrWhiteSpace($hostName)) { throw \"runScript did not capture \\$hostName\" }\nif ($answer -ne '42') { throw \"runScript param capture: expected 42, got '$answer'\" }\nif ($runspace -ne 'runspace') { throw \"runspace engine capture: '$runspace'\" }\nif ($psMajor -ne '5') { throw \"engine=powershell should be Windows PowerShell 5.1, got major '$psMajor'\" }\nif ($isoOut -notmatch 'isolated ok') { throw \"isolated run produced: '$isoOut'\" }\nif ($exit3 -ne '3') { throw \"successExitCodes: expected exitCode 3, got '$exit3'\" }\nif ($transcr -notmatch 'transcript line') { throw \"transcript output: '$transcr'\" }\nif ($retried -ne 'ok') { throw \"retry block changed the result: '$retried'\" }\nif ($linear -notmatch 'linear') { throw \"linear backoff variant produced: '$linear'\" }\nif ($expo -notmatch 'exponential') { throw \"exponential backoff variant produced: '$expo'\" }\n$assertOk = 'runScript'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "runScript",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
