{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] waitForCondition",
      "description": "All five condition types. The port and URL probes target the API's own listener, discovered at run time, so the workflow is not tied to one port.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 3/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 3/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "disc",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "Discover the API's own listening port",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n# waitForCondition probes must target something that is genuinely listening. The script\n# runs inside the API process, so the process itself is the only reliable fixture.\n$ownPid = [System.Diagnostics.Process]::GetCurrentProcess().Id\n$listener = Get-NetTCPConnection -State Listen -OwningProcess $ownPid -ErrorAction SilentlyContinue |\n  Sort-Object LocalPort | Select-Object -First 1\nif (-not $listener) { throw 'could not discover a listening port for the API process' }\n$selfPort = $listener.LocalPort.ToString()\n"
              },
              "outputVariable": "disc",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "wait: script expression",
              "activityType": "waitForCondition",
              "config": {
                "conditionType": "script",
                "script": "$true",
                "intervalSeconds": 1,
                "timeoutSeconds": 15
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "wait: pathExists",
              "activityType": "waitForCondition",
              "config": {
                "conditionType": "pathExists",
                "path": "C:\\Windows",
                "intervalSeconds": 1,
                "timeoutSeconds": 15
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "wait: serviceRunning",
              "activityType": "waitForCondition",
              "config": {
                "conditionType": "serviceRunning",
                "serviceName": "EventLog",
                "intervalSeconds": 1,
                "timeoutSeconds": 15
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "wait: portOpen (own port)",
              "activityType": "waitForCondition",
              "config": {
                "conditionType": "portOpen",
                "host": "localhost",
                "port": "{{disc.param.selfPort}}",
                "intervalSeconds": 1,
                "timeoutSeconds": 15
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "wait: httpOk",
              "activityType": "waitForCondition",
              "config": {
                "conditionType": "httpOk",
                "url": "{{globals.NP_TESTSUITE_SELF_URL}}",
                "intervalSeconds": 1,
                "timeoutSeconds": 15
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$scriptAttempts = {{v0.param.attempts}}\n$scriptElapsed  = {{v0.param.elapsedSeconds}}\n$pathResult     = {{v1.param.lastResult}}\n$svcAttempts    = {{v2.param.attempts}}\n$portAttempts   = {{v3.param.attempts}}\n$httpAttempts   = {{v4.param.attempts}}\n\n# A condition that is already true must settle on the first poll, not burn the interval.\nif ([int]$scriptAttempts -lt 1) { throw \"waitForCondition script attempts: $scriptAttempts\" }\nif ([int]$scriptElapsed -gt 10) { throw \"an immediately true condition took $scriptElapsed s\" }\nif ([string]::IsNullOrWhiteSpace($pathResult)) { throw \"pathExists reported no lastResult\" }\nif ([int]$svcAttempts -lt 1)  { throw \"serviceRunning attempts: $svcAttempts\" }\nif ([int]$portAttempts -lt 1) { throw \"portOpen attempts: $portAttempts\" }\nif ([int]$httpAttempts -lt 1) { throw \"httpOk attempts: $httpAttempts\" }\n$assertOk = 'waitForCondition'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "waitForCondition",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-janitor",
            "source": "trg",
            "target": "janitor",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-janitor-cid",
            "source": "janitor",
            "target": "cid",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cid-mkrun",
            "source": "cid",
            "target": "mkrun",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-mkrun-disc",
            "source": "mkrun",
            "target": "disc",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-disc-v0",
            "source": "disc",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v0-v1",
            "source": "v0",
            "target": "v1",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v1-v2",
            "source": "v1",
            "target": "v2",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v2-v3",
            "source": "v2",
            "target": "v3",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            },
            "sourceHandle": "bottom",
            "targetHandle": "top"
          },
          {
            "id": "e-v3-v4",
            "source": "v3",
            "target": "v4",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v4-cleanup",
            "source": "v4",
            "target": "cleanup",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cleanup-assert",
            "source": "cleanup",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
