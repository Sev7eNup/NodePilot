{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] sql",
      "description": "Builder mode against sqlite in memory and on disk, bound parameters in both syntaxes, rowCount, rowsAffected, the flat row projection and the 1000-row cap.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 10/15 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 10/15 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "mkrun",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Sandbox: create run dir",
              "activityType": "folderOperation",
              "config": {
                "operation": "create",
                "path": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}"
              },
              "outputVariable": "mkrun",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "sql: literal select",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": ":memory:",
                "query": "SELECT 1 AS val, 'suite' AS msg"
              },
              "outputVariable": "v0"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "sql: multi row",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": ":memory:",
                "query": "SELECT 1 AS x UNION SELECT 2 UNION SELECT 3"
              },
              "outputVariable": "v1"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "sql: bound parameters",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": ":memory:",
                "query": "SELECT @needle AS echoed, :second AS other",
                "parameters": {
                  "needle": "bound-value",
                  "second": "42"
                }
              },
              "outputVariable": "v2"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "sql: create table",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\suite.db",
                "query": "CREATE TABLE IF NOT EXISTS t (id INTEGER, name TEXT)"
              },
              "outputVariable": "v3"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "sql: insert (rowsAffected)",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\suite.db",
                "query": "INSERT INTO t (id, name) VALUES (1, 'a'), (2, 'b')"
              },
              "outputVariable": "v4"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "sql: read back",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": "C:\\Temp\\NP-TestSuite\\runs\\{{cid.param.text}}\\suite.db",
                "query": "SELECT id, name FROM t ORDER BY id"
              },
              "outputVariable": "v5"
            }
          },
          {
            "id": "v6",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "sql: row cap",
              "activityType": "sql",
              "config": {
                "provider": "sqlite",
                "timeoutSeconds": 15,
                "dataSource": ":memory:",
                "query": "WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<1500) SELECT x FROM c"
              },
              "outputVariable": "v6"
            }
          },
          {
            "id": "cleanup",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "Cleanup: run sandbox",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$dir = Join-Path 'C:\\Temp\\NP-TestSuite\\runs' $cid\nRemove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue\n\n$cleanupDone = 'ok'\n"
              },
              "outputVariable": "cleanup",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$val      = {{v0.param.val}}\n$msg      = {{v0.param.msg}}\n$rows     = {{v1.param.rowCount}}\n$echoed   = {{v2.param.echoed}}\n$other    = {{v2.param.other}}\n$affected = {{v4.param.rowsAffected}}\n$readRows = {{v5.param.rowCount}}\n$firstName = {{v5.param.row0_name}}\n$capRows   = {{v6.param.rowCount}}\n$truncated = {{v6.param.truncated}}\n\nif ($val -ne '1')      { throw \"sql scalar column: '$val'\" }\nif ($msg -ne 'suite')  { throw \"sql text column: '$msg'\" }\nif ([int]$rows -ne 3)  { throw \"sql multi-row rowCount: $rows\" }\nif ($echoed -ne 'bound-value') { throw \"sql @name binding: '$echoed'\" }\nif ($other -ne '42')   { throw \"sql :name binding: '$other'\" }\nif ([int]$affected -ne 2) { throw \"sql rowsAffected: $affected\" }\nif ([int]$readRows -ne 2) { throw \"sql read back rowCount: $readRows\" }\nif ($firstName -ne 'a') { throw \"sql flat projection row0_name: '$firstName'\" }\nif ([int]$capRows -ne 1000) { throw \"sql row cap should stop at 1000, got $capRows\" }\nif ($truncated -ne 'True' -and $truncated -ne 'true') {\n  throw \"sql should report truncated when the cap is hit, got '$truncated'\"\n}\n$assertOk = 'sql'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "sql",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-janitor",
            "source": "trg",
            "target": "janitor",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-janitor-cid",
            "source": "janitor",
            "target": "cid",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cid-mkrun",
            "source": "cid",
            "target": "mkrun",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-mkrun-v0",
            "source": "mkrun",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
