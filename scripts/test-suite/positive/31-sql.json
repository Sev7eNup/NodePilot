            }
          },
          {
            "id": "e-v3-v4",
            "source": "v3",
            "target": "v4",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            },
            "sourceHandle": "bottom",
            "targetHandle": "top"
          },
          {
            "id": "e-v4-v5",
            "source": "v4",
            "target": "v5",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v5-v6",
            "source": "v5",
            "target": "v6",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v6-cleanup",
            "source": "v6",
            "target": "cleanup",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cleanup-assert",
            "source": "cleanup",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
