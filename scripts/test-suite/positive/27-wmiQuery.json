{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite] wmiQuery",
      "description": "All three modes including a static method in a second namespace, a WHERE filter, method arguments and the projection that captureProperties drives.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 1/5 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 1/5 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "wmi: query + captureProperties",
              "activityType": "wmiQuery",
              "config": {
                "mode": "query",
                "className": "Win32_OperatingSystem",
                "namespace": "root\\cimv2",
                "captureProperties": [
                  "Caption",
                  "Version"
                ]
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "wmi: query + filter",
              "activityType": "wmiQuery",
              "config": {
                "mode": "query",
                "className": "Win32_LogicalDisk",
                "filter": "DriveType=3",
                "namespace": "root\\cimv2",
                "captureProperties": [
                  "DeviceID"
                ]
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "wmi: raw WQL",
              "activityType": "wmiQuery",
              "config": {
                "mode": "wql",
                "query": "SELECT Name, NumberOfLogicalProcessors FROM Win32_ComputerSystem",
                "namespace": "root\\cimv2",
                "captureProperties": [
                  "Name"
                ]
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "wmi: instance method",
              "activityType": "wmiQuery",
              "config": {
                "mode": "invokeMethod",
                "className": "Win32_Process",
                "methodName": "GetOwner",
                "filter": "Name='explorer.exe'",
                "namespace": "root\\cimv2",
                "captureProperties": [
                  "ReturnValue"
                ]
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "wmi: static method, root\\default",
              "activityType": "wmiQuery",
              "config": {
                "mode": "invokeMethod",
                "className": "StdRegProv",
                "methodName": "EnumKey",
                "namespace": "root\\default",
                "arguments": {
                  "sSubKeyName": "SOFTWARE"
                },
                "captureProperties": [
                  "ReturnValue"
                ]
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "wmi: no captureProperties",
              "activityType": "wmiQuery",
              "config": {
                "mode": "query",
                "className": "Win32_BIOS",
                "namespace": "root\\cimv2"
              },
              "outputVariable": "v5",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$caption = {{v0.param.Caption}}\n$version = {{v0.param.Version}}\n$osCount = {{v0.param.count}}\n$disk    = {{v1.param.DeviceID}}\n$csName  = {{v2.param.Name}}\n$ownerRc = {{v3.param.ReturnValue}}\n$regRc   = {{v4.param.ReturnValue}}\n$biosOut = {{v5.output}}\n\nif ($caption -notmatch 'Windows') { throw \"wmi Caption: '$caption'\" }\nif ([string]::IsNullOrWhiteSpace($version)) { throw \"wmi Version was not captured\" }\nif ([int]$osCount -ne 1) { throw \"Win32_OperatingSystem count: $osCount\" }\nif ($disk -notmatch ':') { throw \"filtered DriveType=3 query returned '$disk'\" }\nif ([string]::IsNullOrWhiteSpace($csName)) { throw \"wql Name was not captured\" }\nif ($ownerRc -ne '0') { throw \"GetOwner ReturnValue: '$ownerRc'\" }\nif ($regRc -ne '0') { throw \"StdRegProv.EnumKey ReturnValue: '$regRc'\" }\nif ([string]::IsNullOrWhiteSpace($biosOut)) { throw \"a query without captureProperties still returns output\" }\n$assertOk = 'wmiQuery'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "wmiQuery",
                  "asserted": "{{assert.success}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-v0",
            "source": "trg",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v0-v1",
            "source": "v0",
            "target": "v1",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v1-v2",
            "source": "v1",
            "target": "v2",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v2-v3",
            "source": "v2",
            "target": "v3",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v3-v4",
            "source": "v3",
            "target": "v4",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v4-v5",
            "source": "v4",
