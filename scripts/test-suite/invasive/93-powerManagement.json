{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite-Inv] powerManagement",
      "description": "Cancels any pending shutdown or restart on the host. Runs only where the host owner has opted into the invasive profile and declared the host disposable.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 7/30 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 7/30 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "power: abort",
              "activityType": "powerManagement",
              "config": {
                "action": "abort"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$out = {{v0.output}}\n# `shutdown /a` exits 1116 when there is nothing to abort; the activity treats that as success.\nif ([string]::IsNullOrWhiteSpace($out)) { throw \"powerManagement abort produced no output\" }\n$assertOk = 'powerManagement'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "powerManagement",
                  "asserted": "{{assert.success}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-v0",
            "source": "trg",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v0-assert",
            "source": "v0",
            "target": "assert",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-assert-ret",
            "source": "assert",
            "target": "ret",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          }
        ]
      }
    }
  ]
}
