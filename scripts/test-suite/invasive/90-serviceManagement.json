{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-08-30T00:00:00Z",
  "workflows": [
    {
      "name": "[TestSuite-Inv] serviceManagement",
      "description": "Creates a disposable service, walks all four startup types, reads its status and deletes it again. Needs an elevated service account.",
      "definition": {
        "nodes": [
          {
            "id": "trg",
            "type": "activity",
            "position": {
              "x": 0,
              "y": 260
            },
            "data": {
              "label": "Schedule: 0 22/30 * * * ? *",
              "activityType": "scheduleTrigger",
              "config": {
                "cronExpression": "0 22/30 * * * ? *",
                "description": "TestSuite cadence"
              },
              "outputVariable": "trg"
            }
          },
          {
            "id": "janitor",
            "type": "activity",
            "position": {
              "x": 380,
              "y": 260
            },
            "data": {
              "label": "Janitor: stale run residue",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$root = 'C:\\Temp\\NP-TestSuite'\nforeach ($d in @('runs', 'runtime\\watch', 'runtime\\db', 'runtime\\acks')) {\n  New-Item -ItemType Directory -Path (Join-Path $root $d) -Force | Out-Null\n}\n$cutoff = (Get-Date).AddHours(-1)\nGet-ChildItem -LiteralPath (Join-Path $root 'runs') -Directory -ErrorAction SilentlyContinue |\n  Where-Object { $_.LastWriteTime -lt $cutoff } |\n  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue\n$janitorSweep = 'ok'\n\nGet-Service -Name 'NPTestSvc_*' -ErrorAction SilentlyContinue | ForEach-Object {\n  & sc.exe delete $_.Name | Out-Null\n}\nGet-ScheduledTask -TaskPath '\\NodePilot-TestSuite\\' -ErrorAction SilentlyContinue |\n  Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue\n$invasiveSweep = 'ok'\n"
              },
              "outputVariable": "janitor",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "cid",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 260
            },
            "data": {
              "label": "Correlation id",
              "activityType": "generateText",
              "config": {
                "mode": "guid"
              },
              "outputVariable": "cid"
            }
          },
          {
            "id": "names",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 260
            },
            "data": {
              "label": "Derive per-run fixture names",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 20,
                "script": "$cid = {{cid.param.text}}\n$short = $cid.Substring(0, 8)\n$svcName = \"NPTestSvc_$short\"\n$taskName = \"NPTestTask_$short\"\n"
              },
              "outputVariable": "names",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v0",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 260
            },
            "data": {
              "label": "svc: create",
              "activityType": "serviceManagement",
              "config": {
                "action": "create",
                "serviceName": "{{names.param.svcName}}",
                "binaryPath": "C:\\Windows\\System32\\cmd.exe /c rem nodepilot-testsuite",
                "displayName": "NodePilot TestSuite fixture",
                "description": "Disposable service created by the NodePilot test suite.",
                "startupType": "Manual"
              },
              "outputVariable": "v0",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v1",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 260
            },
            "data": {
              "label": "svc: setStartType Automatic",
              "activityType": "serviceManagement",
              "config": {
                "action": "setStartType",
                "serviceName": "{{names.param.svcName}}",
                "startupType": "Automatic"
              },
              "outputVariable": "v1",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v2",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 260
            },
            "data": {
              "label": "svc: setStartType AutomaticDelayedStart",
              "activityType": "serviceManagement",
              "config": {
                "action": "setStartType",
                "serviceName": "{{names.param.svcName}}",
                "startupType": "AutomaticDelayedStart"
              },
              "outputVariable": "v2",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v3",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 260
            },
            "data": {
              "label": "svc: setStartType Manual",
              "activityType": "serviceManagement",
              "config": {
                "action": "setStartType",
                "serviceName": "{{names.param.svcName}}",
                "startupType": "Manual"
              },
              "outputVariable": "v3",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v4",
            "type": "activity",
            "position": {
              "x": 2300,
              "y": 500
            },
            "data": {
              "label": "svc: setStartType Disabled",
              "activityType": "serviceManagement",
              "config": {
                "action": "setStartType",
                "serviceName": "{{names.param.svcName}}",
                "startupType": "Disabled"
              },
              "outputVariable": "v4",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v5",
            "type": "activity",
            "position": {
              "x": 1980,
              "y": 500
            },
            "data": {
              "label": "svc: status",
              "activityType": "serviceManagement",
              "config": {
                "action": "status",
                "serviceName": "{{names.param.svcName}}"
              },
              "outputVariable": "v5",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "v6",
            "type": "activity",
            "position": {
              "x": 1660,
              "y": 500
            },
            "data": {
              "label": "svc: delete",
              "activityType": "serviceManagement",
              "config": {
                "action": "delete",
                "serviceName": "{{names.param.svcName}}"
              },
              "outputVariable": "v6",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "teardown",
            "type": "activity",
            "position": {
              "x": 1340,
              "y": 500
            },
            "data": {
              "label": "Teardown: remove fixtures",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 30,
                "script": "\n$cid = {{cid.param.text}}\n$short = $cid.Substring(0, 8)\n& sc.exe delete \"NPTestSvc_$short\" | Out-Null\nGet-ScheduledTask -TaskName \"NPTestTask_$short\" -TaskPath '\\NodePilot-TestSuite\\' -ErrorAction SilentlyContinue |\n  Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue\n$teardownDone = 'ok'\n"
              },
              "outputVariable": "teardown",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "assert",
            "type": "activity",
            "position": {
              "x": 1020,
              "y": 500
            },
            "data": {
              "label": "Assert: all variants",
              "activityType": "runScript",
              "config": {
                "engine": "auto",
                "timeoutSeconds": 60,
                "script": "\n$name      = {{v5.param.name}}\n$status    = {{v5.param.status}}\n$startType = {{v5.param.startType}}\n$svcName   = {{names.param.svcName}}\n\nif ($name -ne $svcName) { throw \"status returned service '$name', expected '$svcName'\" }\nif ([string]::IsNullOrWhiteSpace($status)) { throw \"status did not report a state\" }\n# The last setStartType before the status read was Disabled.\nif ($startType -notmatch 'Disabled') { throw \"startType after setStartType Disabled: '$startType'\" }\nif (Get-Service -Name $svcName -ErrorAction SilentlyContinue) {\n  throw \"the fixture service still exists after delete\"\n}\n$assertOk = 'serviceManagement'\n"
              },
              "outputVariable": "assert",
              "targetMachineId": "localhost"
            }
          },
          {
            "id": "ret",
            "type": "activity",
            "position": {
              "x": 700,
              "y": 500
            },
            "data": {
              "label": "Return",
              "activityType": "returnData",
              "config": {
                "data": {
                  "activity": "serviceManagement",
                  "asserted": "{{assert.success}}",
                  "cid": "{{cid.param.text}}"
                }
              },
              "outputVariable": "ret"
            }
          }
        ],
        "edges": [
          {
            "id": "e-trg-janitor",
            "source": "trg",
            "target": "janitor",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-janitor-cid",
            "source": "janitor",
            "target": "cid",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-cid-names",
            "source": "cid",
            "target": "names",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-names-v0",
            "source": "names",
            "target": "v0",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v0-v1",
            "source": "v0",
            "target": "v1",
            "type": "labeled",
            "data": {
              "label": "Always",
              "condition": ""
            }
          },
          {
            "id": "e-v1-v2",
            "source": "v1",
