          "script": "$removed = @()\nforeach ($p in @('C:\\NP-WinRM-Test','C:\\NP-WinRM-Test.zip','C:\\NP-WinRM-Test-unzip')) {\n    if (Test-Path -LiteralPath $p) { Remove-Item -LiteralPath $p -Recurse -Force; $removed += $p }\n}\nif (Test-Path -LiteralPath 'HKLM:\\SOFTWARE\\NodePilotLabTest') { Remove-Item -LiteralPath 'HKLM:\\SOFTWARE\\NodePilotLabTest' -Recurse -Force; $removed += 'HKLM:\\SOFTWARE\\NodePilotLabTest' }\n$cleanupCount = $removed.Count\nWrite-Output \"cleaned=$cleanupCount :: $($removed -join ', ')\"",
          "timeoutSeconds": 120
        }
      }
