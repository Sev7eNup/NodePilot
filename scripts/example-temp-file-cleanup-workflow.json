{
  "schema": "nodepilot-workflow-export/v1",
  "exportVersion": 1,
  "exportedAt": "2026-09-18T00:00:00Z",
  "workflows": [
    {
      "name": "Temp File Cleanup",
      "description": "Archives a temp folder into a new ZIP per source folder and run, then inventories the folder and computes the archive checksum in parallel. After both checks succeed, aged-out originals are removed and a summary mail is sent. Earlier archives are never replaced, so files a previous run deleted stay recoverable.",
      "definition": {
        "nodes": [
          { "id": "note_input", "type": "stickyNote", "position": { "x": 0, "y": 60 },
            "style": { "width": 640, "height": 110 },
            "data": { "label": "Note", "activityType": "note",
              "text": "Phase A - Input\nThe three trigger parameters are the only thing to fill in. All are declared as strings: the run dialog sends strings, and a number would be rejected on execute. Each run writes a new archive under archiveRoot.",
              "fontSize": 13, "disabled": true } },
          { "id": "note_finish", "type": "stickyNote", "position": { "x": 900, "y": 60 },
            "style": { "width": 1440, "height": 110 },
            "data": { "label": "Note", "activityType": "note",
              "text": "Phase B - Verify and clean\nInventory and checksum run in parallel after successful archiving. waitAll joins both checks; only successful checks allow deletion. The summary mail follows successful cleanup.",
              "fontSize": 13, "disabled": true } },

          { "id": "trg", "type": "activity", "position": { "x": 0, "y": 400 },
            "data": {
              "label": "Manual Trigger: cleanup run",
              "activityType": "manualTrigger",
              "config": {
                "title": "Temp File Cleanup",
                "parameters": [
                  { "name": "path",          "type": "string", "required": true, "default": "C:\\Windows\\Temp" },
                  { "name": "olderThanDays", "type": "string", "required": true, "default": "30" },
                  { "name": "archiveRoot",   "type": "string", "required": true, "default": "C:\\Archive" }
                ]
              }
            } },

          { "id": "archivePath", "type": "activity", "position": { "x": 300, "y": 400 },
            "data": {
              "label": "runScript: new archive path for this run",
              "activityType": "runScript",
              "targetMachineId": "localhost",
              "outputVariable": "archivePath",
              "config": {
                "script": "# One archive per source folder and run: a later run must never replace the only copy of files an earlier run deleted.\n$sourceKey = ({{trg.param.path}}.TrimEnd('\\') -replace '[^A-Za-z0-9]+', '-').Trim('-')\nif ($sourceKey.Length -gt 60) { $sourceKey = $sourceKey.Substring($sourceKey.Length - 60) }\n$runStamp = (Get-Date).ToUniversalTime().ToString('yyyyMMddTHHmmssZ')\n$archiveFile = Join-Path {{trg.param.archiveRoot}} ('temp-cleanup-{0}-{1}-{2}.zip' -f $sourceKey, $runStamp, [guid]::NewGuid().ToString('N'))\nif (Test-Path -LiteralPath $archiveFile) { throw \"Archive already exists: $archiveFile\" }\nWrite-Output $archiveFile",
                "timeoutSeconds": 30
              }
            } },

          { "id": "inventory", "type": "activity", "position": { "x": 900, "y": 560 },
            "data": {
              "label": "folderOperation: list the temp folder",
              "activityType": "folderOperation",
              "targetMachineId": "localhost",
              "outputVariable": "inventory",
              "config": { "operation": "list", "path": "{{trg.param.path}}" }
            } },

          { "id": "archive", "type": "activity", "position": { "x": 600, "y": 400 },
            "data": {
              "label": "zipOperation: archive the folder",
              "activityType": "zipOperation",
              "targetMachineId": "localhost",
              "outputVariable": "archive",
              "config": {
                "operation": "compress",
                "source": "{{trg.param.path}}",
                "destination": "{{archivePath.param.archiveFile}}",
                "compressionLevel": "Optimal",
                "force": false
              }
            } },

          { "id": "checksum", "type": "activity", "position": { "x": 900, "y": 240 },
            "data": {
              "label": "fileHash: checksum the archive",
              "activityType": "fileHash",
              "targetMachineId": "localhost",
              "outputVariable": "checksum",
              "config": { "path": "{{archive.param.destination}}", "algorithm": "SHA256" }
            } },

          { "id": "purge", "type": "activity", "position": { "x": 1500, "y": 400 },
            "data": {
              "label": "runScript: remove the archived files",
              "activityType": "runScript",
              "targetMachineId": "localhost",
              "outputVariable": "purge",
              "config": {
                "script": "$cutoff = (Get-Date).AddDays(-[int]{{trg.param.olderThanDays}})\n$aged = Get-ChildItem {{trg.param.path}} -File -Force -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -lt $cutoff }\n$removedCount = ($aged | Measure-Object).Count\n$aged | Remove-Item -Force -ErrorAction SilentlyContinue\nWrite-Output \"Removed $removedCount file(s) last written before $cutoff.\"",
                "timeoutSeconds": 300
              }
            } },

          { "id": "gather", "type": "activity", "position": { "x": 1200, "y": 400 },
            "data": {
              "label": "Junction: waitAll (2)",
              "activityType": "junction",
              "config": { "mode": "waitAll" }
            } },

          { "id": "mail", "type": "activity", "position": { "x": 1800, "y": 400 },
            "data": {
              "label": "Email: cleanup summary",
              "activityType": "emailNotification",
              "config": {
                "to": "ops@contoso.example",
                "subject": "Temp cleanup finished",
                "body": "{{purge.output}}\n\nArchive: {{archive.param.destination}}\nSHA256: {{checksum.param.hash}}",
                "isHtml": false
              }
            } },

          { "id": "ret", "type": "activity", "position": { "x": 2100, "y": 400 },
            "data": {
              "label": "Return: archive and checksum",
              "activityType": "returnData",
              "config": {
                "data": {
                  "archive": "{{archive.param.destination}}",
                  "hash": "{{checksum.param.hash}}"
                }
              }
            } }
        ],
        "edges": [
          { "id": "e_trg_path", "source": "trg", "target": "archivePath", "type": "labeled",
            "data": { "label": "Always" } },
          { "id": "e_path_archive", "source": "archivePath", "target": "archive", "type": "labeled",
            "data": { "label": "On Success", "condition": "archivePath.success" } },
          { "id": "e_archive_checksum", "source": "archive", "target": "checksum", "type": "labeled",
            "data": { "label": "On Success", "condition": "archive.success" } },
          { "id": "e_archive_inventory", "source": "archive", "target": "inventory", "type": "labeled",
            "data": { "label": "On Success", "condition": "archive.success" } },

          { "id": "e_checksum_gather", "source": "checksum", "target": "gather", "type": "labeled",
            "data": { "label": "Always" } },
          { "id": "e_inventory_gather", "source": "inventory", "target": "gather", "type": "labeled",
            "data": { "label": "Always" } },

          { "id": "e_gather_purge", "source": "gather", "target": "purge", "type": "labeled",
            "data": { "label": "Checks succeeded", "conditionExpression": {
              "type": "group", "op": "AND", "children": [
                { "type": "comparison", "left": { "kind": "variable", "stepId": "checksum", "field": "success" }, "op": "isTrue" },
                { "type": "comparison", "left": { "kind": "variable", "stepId": "inventory", "field": "success" }, "op": "isTrue" }
              ]
            } } },
          { "id": "e_purge_mail", "source": "purge", "target": "mail", "type": "labeled",
            "data": { "label": "On Success", "condition": "purge.success" } },
          { "id": "e_mail_ret", "source": "mail", "target": "ret", "type": "labeled",
            "data": { "label": "Always" } }
        ]
      }
    }
  ]
}
