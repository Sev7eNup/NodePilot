{
  "Database": {
    "Provider": "postgres",
    "AllowInsecureTls": false
  },
  "Deployment": {
    "Mode": "Server"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NodePilot;Trusted_Connection=True;TrustServerCertificate=False;Encrypt=Strict;Application Name=NodePilot;Min Pool Size=40;Max Pool Size=800",
    "Postgres": "Host=localhost;Port=5432;Database=nodepilot;Username=nodepilot;SSL Mode=VerifyFull;Check Certificate Revocation=true;Maximum Pool Size=800;Minimum Pool Size=40;Connection Idle Lifetime=60"
  },
  "Jwt": {
    "Issuer": "NodePilot",
    "Audience": "NodePilot"
  },
  "Authentication": {
    "LocalLoginMode": "BreakGlassOnly",
    "SessionAbsoluteLifetimeHours": 8,
    "MaxAuthorizationStalenessMinutes": 15,
    "Ldap": {
      "Enabled": false,
      "Endpoints": [],
      "Port": 636,
      "UseSsl": true,
      "AllowedGroupSids": [],
      "DirectorySyncIntervalMinutes": 5,
      "DirectorySyncMaxConcurrency": 16
    },
    "Windows": {
      "Enabled": false,
      "AllowNtlmFallback": false,
      "NtlmDisabledByPolicy": false
    },
    "Oidc": {
      "Enabled": false,
      "Scopes": ["openid", "profile", "email"],
      "AllowedGroupIds": []
    },
    "Scim": {
      "Enabled": false,
      "BearerToken": null,
      "PreviousBearerToken": null,
      "Authority": null
    }
  },
  "DataProtection": {
    "KeyRingPath": "data-protection-keys",
    "CertificateThumbprint": null,
    "SharedKeyRing": false
  },
  "Security": {
    "StrictAllowedHosts": true
  },
  "Swagger": {
    "DisableInNonDevelopment": true
  },
  "Credentials": {
    "DpapiScope": "CurrentUser"
  },
  "ExternalTrigger": {
    "ApiKey": ""
  },
  "Webhook": {
    "RequireSecret": true
  },
  "Remote": {
    "Provider": "winrm",
    "RequireWinRmSsl": true,
    "WinRm": {
      "OperationTimeoutSeconds": 300,
      "OpenTimeoutSeconds": 30
    },
    "Pool": {
      "Enabled": true,
      "MaxConcurrentPerMachine": 5,
      "MaxIdlePerKey": 5,
      "IdleTtlSeconds": 120
    },
    "Noop": {
      "MinLatencyMs": 0,
      "MaxLatencyMs": 0,
      "SimulateFailures": false,
      "FailureRate": 0.0
    }
  },
  "FileSystemOperation": {
    "RejectTraversal": true
  },
  "SqlActivity": {
    "RequireConnectionRef": true
  },
  // Allow-list for the PowerShell-backed network probes of waitForCondition (portOpen /
  // httpOk). These cannot re-validate the destination at connect time the way restApi does,
  // so they accept ONLY hosts listed here — an empty list rejects every probe.
  // "localhost" ships enabled because "is my own service up" is a core orchestrator use case;
  // it is deliberately NOT the same list as RestApi:AllowedHosts, so permitting a local probe
  // does not also open restApi's loopback exception (whose URLs can come from trigger
  // payloads). Other spellings match exactly: add "127.0.0.1"/"::1" if workflows use them.
  "WaitForCondition": {
    "AllowedHosts": [ "localhost" ]
  },
  "Trigger": {
    "Database": {
      "RequireConnectionRef": true
    }
  },
  "StartProgram": {
    "DisallowShellExecute": true
  },
  "ExecutionDispatch": {
    "Capacity": 2048,
    "WorkerCount": 600
  },
  // Sizing mode. Off (the default) NodePilot derives the Engine / Threading / ExecutionDispatch
  // numbers below from the detected CPU and memory, so the same build sizes itself sensibly on a
  // laptop and on a 32-core server. Switch it on — here or in Settings > System > Performance —
  // to use those numbers verbatim; they are the profile measured for 20 cores / 500 parallel
  // workflows and are kept as an immediately activatable preset. Scaling heuristic and measured
  // evidence: docs/performance-improvements.md.
  "Performance": {
    "ManualTuning": false
  },
  "Engine": {
    "Debug": {
      "MaxPauseMinutes": 10
    },
    "MaxConcurrentExecutions": {
      "Global": 5000,
      "PerUser": 2000
    },
    "MaxConcurrentSteps": 600,
    "IsolatedDrainGraceSeconds": 5,
    "Runspace": {
      "MinRunspaces": 256,
      "MaxRunspaces": 768
    }
  },
  "Threading": {
    "MinWorkerThreads": 768,
    "MinIoCompletionThreads": 768
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "From": "nodepilot@localhost"
  },
  // Connections live in Profiles, keyed by an immutable profile id; ActiveProfileId picks the one
  // every AI feature uses. Ships EMPTY on purpose: profiles defined here would be layered under
  // appsettings.runtime.json and could therefore never be deleted through the Settings UI (the
  // base-config entry would resurface on the next reload). Create profiles in the UI instead —
  // Settings → System → Integrations → LLM.
  "Llm": {
    "Enabled": false,
    "ActiveProfileId": "",
    "Profiles": {},
    // Outbound proxy for every LLM call. "Off" (default) connects directly, exactly as this
    // client always has. "System" adopts the proxy the service account's OS is configured with —
    // the usual answer in corporate networks with a mandatory outbound proxy. "Custom" uses
    // Address plus the BypassList globs below.
    "Proxy": {
      "Mode": "Off",
      "Address": "",
      "BypassList": [],
      "Username": null,
      "Password": null,
      "UseDefaultCredentials": false
    }
  },
  "AiKnowledge": {
    "Enabled": false,
    "DocsEnabled": true,
    "OperationalEnabled": true,
    "SourceCodeEnabled": false,
    "DocsRootPath": "",
    "SourceCodeRootPath": "",
    "DocsMaxFileBytes": 262144,
    "DocsMaxResults": 20,
    "SourceCodeMaxFileBytes": 262144,
    "SourceCodeMaxResults": 20
  },
  "Logging": {
    "Format": "cmtrace",
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
    },
    "StepDetail": {
      "Enabled": false,
      "MaxOutputChars": 10000
    },
    "File": {
      "RetainedFileCountLimit": 7,
      "FileSizeLimitBytes": 104857600
    },
    "Redaction": {
      "Enabled": true
    },
    "SupportLog": {
      "Enabled": true,
      "Path": "",
      "RetainedFileCountLimit": 90,
      "FileSizeLimitBytes": 10485760,
      "DbProjectionEnabled": true
    }
  },
  "Retention": {
    "Executions": {
      "Enabled": true,
      "MaxAgeDays": 30,
      "IntervalMinutes": 60,
      "BatchSize": 500,
      "ArchivePath": ""
    },
    "AuditLog": {
      "Enabled": true,
      "MaxAgeDays": 365,
      "IntervalMinutes": 720,
      "BatchSize": 1000,
      "ArchivePath": "",
      "VerifyIntervalMinutes": 1440,
      "VerifyMaxFilesPerPass": 500
    },
    "WorkflowVersions": {
      "Enabled": true,
      "MaxVersionsPerWorkflow": 50,
      "IntervalMinutes": 1440,
      "BatchSize": 500
    },
    "SupportEvents": {
      "Enabled": true,
      "MaxAgeDays": 90,
      "IntervalMinutes": 360
    }
  },
  "Alerting": {
    "LongRunningSeconds": 600
  },
  "Stats": {
    "RefreshIntervalMinutes": 5,
    "WindowDays": 7,
    "DurationSampleCap": 1000
  },
  "RestApi": {
    "BlockPrivateNetworks": true,
    "AllowedHosts": [],
    "Proxy": {
      "Enabled": false,
      "Address": "",
      "BypassList": [],
      "Username": null,
      "Password": null
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "nodepilot-api",
    "Environment": "dev",
    "RedactHostnames": true,
    "MetricExportIntervalSeconds": 30,
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc",
      "Headers": "",
      "BrowserEndpoint": ""
    },
    "Sampling": {
      "Mode": "ParentBasedTraceIdRatio",
      "Ratio": 1.0
    },
    "Exporters": {
      "Traces": true,
      "Metrics": true,
      "Logs": true,
      "PrometheusScrape": true,
      "PrometheusScrapeAllowAnonymous": false
    },
    "TraceUi": {
      "UrlTemplate": "",
      "BackendName": "Tempo"
    },
    "Prometheus": {
      "QueryEndpoint": "",
      "Username": "",
      "Password": "",
      "BearerToken": "",
      "TimeoutSeconds": 10
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
