{
  "compilerOptions": {
    "target": "ES2022",
    // node16, not the deprecated node10: package.json declares no "type", so this still
    // emits CommonJS for the Electron main process, but resolution now honours the
    // "exports" maps that modern dependencies ship.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
