<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NodePilot.Mcp</RootNamespace>
    <AssemblyName>nodepilot-mcp</AssemblyName>

    <!-- NOT packaged as a dotnet global tool - see NodePilot.Cli.csproj for the full rationale.
         Short version: PackAsTool rejects the net10.0-windows TFM this project inherits, so
         `dotnet pack` fails with NETSDK1146. Distribute via `dotnet publish` and point the MCP
         client's `command` at the produced nodepilot-mcp.exe. -->
    <Version>1.0.0</Version>
    <Authors>NodePilot</Authors>
    <Description>Model Context Protocol server for NodePilot — drive and edit workflows and read data from an AI agent.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NodePilot.Core\NodePilot.Core.csproj" />
  </ItemGroup>

  <!-- Embedded data so the packaged tool works after `dotnet tool install` (no docs/ at runtime). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\workflow-styleguide.md" Link="Resources\Embedded\workflow-styleguide.md" />
  </ItemGroup>

</Project>
