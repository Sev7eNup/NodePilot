    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
