{
  "name": "nodepilot-ui",
  "private": true,
  "version": "1.5.4",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 11",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:demo": "tsc -p tsconfig.demo.json && vite build --config vite.demo.config.ts",
    "dev:demo": "vite --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.ts"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.91.0",
