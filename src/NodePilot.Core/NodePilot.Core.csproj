<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared by NodePilot.Ai (renders the AI prompt's activity catalog) and NodePilot.Mcp
         (serves it as a resource/tool). Lives here so both can reach it without either
         depending on the other. -->
    <EmbeddedResource Include="Activities\Embedded\activity-config-reference.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- PerformanceSizing's floors, ceilings and memory coefficients are internal on purpose:
         they are calibration constants, not API. The tests assert against them by name so a
         changed constant cannot silently invalidate the expectations built on it. -->
    <InternalsVisibleTo Include="NodePilot.Engine.Tests" />
  </ItemGroup>

</Project>
