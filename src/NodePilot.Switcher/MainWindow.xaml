<Window x:Class="NodePilot.Switcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Strings.AppTitle}"
        Width="980" Height="800" MinWidth="820" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="{DynamicResource BrandIcon}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="64"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ThemeToggleButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EngineButtonStyle" TargetType="Button">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="18,22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="24"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid Background="{DynamicResource PageBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Panel.ZIndex="5">
      <Border.Effect>
        <DropShadowEffect Color="#18000000" BlurRadius="10" ShadowDepth="1" Opacity="0.45" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Viewbox Width="26" Height="26" Margin="0,0,11,0">
            <Canvas Width="28" Height="28">
              <Path Data="M4,9 H22 M18,5 L22,9 L18,13 M24,19 H6 M10,15 L6,19 L10,23"
                    Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="{Binding Strings.PageTitle}" FontSize="20" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button x:Name="ThemeToggleButton" Grid.Column="1" Style="{StaticResource ThemeToggleButtonStyle}"
                Click="OnThemeToggleClick">
          <Grid Width="54" Height="28">
            <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="14" />
            <TextBlock Text="☀" FontFamily="Segoe UI Symbol" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="15"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,7,1"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Ellipse x:Name="ThemeToggleThumb" Width="22" Height="22" Margin="3"
                     Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
              <Ellipse.Effect>
                <DropShadowEffect Color="#30000000" BlurRadius="3" ShadowDepth="1" Opacity="0.55" />
              </Ellipse.Effect>
            </Ellipse>
          </Grid>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="&#x2212;" Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeClick"
                  AutomationProperties.Name="Minimize" />
          <Button x:Name="MaximizeButton" Content="&#x25A1;" Style="{StaticResource TitleBarButtonStyle}"
                  Click="OnMaximizeRestoreClick" AutomationProperties.Name="Maximize" />
          <Button Content="&#x2715;" Style="{StaticResource CloseButtonStyle}" Click="OnCloseClick"
                  AutomationProperties.Name="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="32,22,32,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="214" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="{Binding Strings.PageTitle}" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Strings.ChooseEngine}" FontSize="14"
                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.55*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerHighBrush}"
                CornerRadius="8" Padding="20">
          <Border.Effect>
            <DropShadowEffect Color="#19000000" BlurRadius="7" ShadowDepth="2" Opacity="0.55" />
          </Border.Effect>
          <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="28" Padding="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Command="{Binding SwitchToSystemCenterCommand}"
                      AutomationProperties.Name="{Binding Strings.SwitchToSystemCenter}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource EngineButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SystemCenterRunning}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel HorizontalAlignment="Center">
                  <Viewbox Width="42" Height="42" HorizontalAlignment="Center" Margin="0,0,0,13">
                    <Canvas Width="42" Height="42">
                      <Rectangle Canvas.Left="7" Canvas.Top="6" Width="28" Height="12" RadiusX="1" RadiusY="1"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                 StrokeThickness="2.3" />
                      <Rectangle Canvas.Left="7" Canvas.Top="24" Width="28" Height="12" RadiusX="1" RadiusY="1"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                 StrokeThickness="2.3" />
                      <Ellipse Canvas.Left="11" Canvas.Top="10" Width="4" Height="4"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                      <Ellipse Canvas.Left="11" Canvas.Top="28" Width="4" Height="4"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                      <Line X1="19" Y1="12" X2="31" Y2="12"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2" />
                      <Line X1="19" Y1="30" X2="31" Y2="30"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="System Center&#x0a;Orchestrator" TextAlignment="Center"
                             FontSize="14" FontWeight="SemiBold" LineHeight="17" />
                </StackPanel>
              </Button>

              <Button Grid.Column="1" Command="{Binding SwitchToNodePilotCommand}"
                      AutomationProperties.Name="{Binding Strings.SwitchToNodePilot}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource EngineButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding NodePilotRunning}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel HorizontalAlignment="Center">
                  <Viewbox Width="44" Height="42" HorizontalAlignment="Center" Margin="0,0,0,13">
                    <Canvas Width="44" Height="42">
                      <Path Data="M22,3 L37,12 L37,30 L22,39 L7,30 L7,12 Z"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2.1" Fill="Transparent" StrokeLineJoin="Round" />
                      <Path Data="M12,21 H21 M21,21 L30,12 M21,21 L30,30"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      <Ellipse Canvas.Left="9" Canvas.Top="18" Width="6" Height="6"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                      <Ellipse Canvas.Left="18" Canvas.Top="18" Width="6" Height="6"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                      <Ellipse Canvas.Left="27" Canvas.Top="9" Width="6" Height="6"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                      <Ellipse Canvas.Left="27" Canvas.Top="27" Width="6" Height="6"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="NodePilot" TextAlignment="Center"
                             FontSize="14" FontWeight="SemiBold" LineHeight="17" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource SurfaceContainerLowBrush}"
                CornerRadius="8" Padding="20" AutomationProperties.LiveSetting="Polite">
          <Border.Effect>
            <DropShadowEffect Color="#10000000" BlurRadius="5" ShadowDepth="1" Opacity="0.35" />
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
              <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SurfaceVariantBrush}">
                <TextBlock Text="&#x2713;" FontFamily="Segoe UI Symbol" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Strings.ServiceAvailability}" FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                         Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Strings.NodePilotInstallationFound}" FontSize="13"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding NodePilotAvailable}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding NodePilotAvailabilityText}" FontSize="13" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Padding="0,9">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Strings.OrchestratorInstallationFound}" FontSize="13"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SystemCenterAvailable}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SystemCenterAvailabilityText}" FontSize="13" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,5" />
              <ProgressBar Height="3" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                           Background="{DynamicResource SurfaceVariantBrush}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="2" Margin="4,20,4,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Strings.LastActivities}" FontSize="20" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{Binding Strings.Copy}" Command="{Binding CopyActivityCommand}"
                Style="{StaticResource LinkButtonStyle}" />
      </Grid>

      <Border Grid.Row="3" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="8"
              ClipToBounds="True" MinHeight="110">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActivityItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="17,11" BorderBrush="{DynamicResource DividerBrush}"
                          BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12"
                                 FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13.5"
                                 TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="{Binding Strings.NoActivity}" Foreground="{DynamicResource MutedTextBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasActivity}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
            AutomationProperties.LiveSetting="Polite">
      <Grid Margin="32,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Margin="0,0,8,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding FooterStatusIsBusy}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding FooterStatusIsWarning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding FooterStatusIsError}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding FooterStatusText}" FontSize="12.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource DividerBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding FooterDetailText}" FontSize="12.5"
                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding FooterLastSwitchText}" FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}" Margin="24,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>
</Window>
