<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NodePilot.Cli</RootNamespace>
    <AssemblyName>np</AssemblyName>

    <!-- NOT packaged as a dotnet global tool. PackAsTool rejects a platform TFM (NETSDK1146)
         and this project hangs transitively off net10.0-windows, so `dotnet pack` fails outright.
         The properties used to sit here anyway, which is where the "dotnet tool install -g"
         instructions in the README and docs site came from - an install path that never worked.
         Ship it with `dotnet publish` and put the output folder on PATH instead. Rationale for
         not multi-targeting the whole chain: docs/roadmap.md, "Bewusst nicht auf der Roadmap". -->
    <!-- No <Version> here: it is inherited from Directory.Build.props, which is the single
         source for the product version that the release build also reads. -->
    <Authors>NodePilot</Authors>
    <Description>Operations CLI for NodePilot — manage workflows, executions and audit logs from the terminal.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.Console.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NodePilot.Core\NodePilot.Core.csproj" />
  </ItemGroup>

</Project>
