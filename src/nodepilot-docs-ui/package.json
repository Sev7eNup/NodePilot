{
  "name": "nodepilot-docs-ui",
  "version": "1.4.0",
  "description": "NodePilot documentation website — React SPA.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --base=/docs/",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
