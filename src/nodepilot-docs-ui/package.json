{
  "name": "nodepilot-docs-ui",
  "version": "1.4.1",
  "description": "NodePilot documentation website — React SPA.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --base=/docs/",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "assemble:site": "node scripts/assemble-site.mjs",
    "preview:site": "npm run build && npm run build:site && npm run build:demo && npm run assemble:site && vite preview --config vite.site.config.ts --outDir ../../_site",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:site:e2e": "playwright test --config playwright.site.config.ts",
    "build:demo": "npm --prefix ../nodepilot-ui run build:demo"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.88.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
