{
  "//": "Rendered by deploy/desktop/Provision-LocalDb.ps1 to <InstallDir>\\appsettings.Production.json. The desktop package runs with ASPNETCORE_ENVIRONMENT=Production (full hardening: security headers, Swagger off) but Deployment:Mode=Desktop, which relaxes ONLY the loopback-database-TLS check and binds Kestrel to loopback. The Postgres connection string is intentionally NOT written here — it is injected via the ConnectionStrings__Postgres service environment variable (ACL-restricted) so the DB password never touches JSON. Placeholders: {{DATA_PATH_ESCAPED}}, {{HTTPS_PORT}}, {{CERT_THUMBPRINT}}.",
  "Deployment": {
    "Mode": "Desktop"
  },
  "Database": {
    "Provider": "postgres",
    "AllowInsecureTls": true
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "NodePilot",
    "Audience": "NodePilot",
    "KeyPath": "{{DATA_PATH_ESCAPED}}\\jwt-secret.key",
    "RotateInsecureKeyFile": false
  },
  "Authentication": {
    "LocalLoginMode": "Enabled",
    "SessionAbsoluteLifetimeHours": 8,
    "MaxAuthorizationStalenessMinutes": 15,
    "Ldap": { "Enabled": false },
    "Windows": { "Enabled": false, "AllowNtlmFallback": false, "NtlmDisabledByPolicy": false },
    "Oidc": { "Enabled": false },
    "Scim": { "Enabled": false }
  },
  "DataProtection": {
    "KeyRingPath": "{{DATA_PATH_ESCAPED}}\\data-protection-keys",
    "CertificateThumbprint": null,
    "SharedKeyRing": false
  },
  "Security": {
    "AdminSetupTokenPath": "{{DATA_PATH_ESCAPED}}\\admin-setup.token",
    "StrictAllowedHosts": true
  },
  "Settings": {
    "RuntimeOverridesPath": "{{DATA_PATH_ESCAPED}}\\appsettings.runtime.json"
  },
  "Kestrel": {
    "Https": {
      "Enabled": true,
      "HttpsPort": {{HTTPS_PORT}},
      "BindHttp": false,
      "CertificateLocation": "LocalMachine",
      "CertificateStore": "My",
      "CertificateThumbprint": "{{CERT_THUMBPRINT}}",
      "RedirectHttpToHttps": false
    }
  },
  "Credentials": {
    "DpapiScope": "LocalMachine"
  },
  "Remote": {
    "Provider": "winrm",
    "RequireWinRmSsl": true,
    "Pool": { "Enabled": true, "IdleTtlSeconds": 120 }
  },
  "Logging": {
    "Format": "cmtrace",
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
    },
    "File": {
      "Path": "{{DATA_PATH_ESCAPED}}\\logs\\nodepilot-.log",
      "RetainedFileCountLimit": 7,
      "FileSizeLimitBytes": 104857600
    },
    "StepDetail": { "Enabled": false, "MaxOutputChars": 10000 },
    "Redaction": { "Enabled": true },
    "SupportLog": {
      "Enabled": true,
      "Path": "{{DATA_PATH_ESCAPED}}\\logs\\nodepilot-support-.log",
      "RetainedFileCountLimit": 90,
      "FileSizeLimitBytes": 10485760,
      "DbProjectionEnabled": true
    }
  },
  // Sizing mode. Off: NodePilot derives the numbers below from the detected CPU and memory, which
  // on a desktop is the better fit — the machine also runs Postgres, the Electron shell and the
  // user's own applications, and its core count varies far more than a server's. The values kept
  // below are the proven desktop preset (measured 383 MB / 57 threads after 25 h) and can be
  // activated by switching this on.
  "Performance": {
    "ManualTuning": false
  },
  "Engine": {
    "Debug": { "MaxPauseMinutes": 10 },
    "MaxConcurrentExecutions": { "Global": 200, "PerUser": 100 },
    "MaxConcurrentSteps": 32,
    "IsolatedDrainGraceSeconds": 5,
    "Runspace": { "MinRunspaces": 8, "MaxRunspaces": 64 }
  },
  "Threading": {
    "MinWorkerThreads": 32,
    "MinIoCompletionThreads": 32
  },
  "ExecutionDispatch": {
    "Capacity": 512,
    "WorkerCount": 32
  },
  "Stats": { "RefreshIntervalMinutes": 5, "WindowDays": 7 },
  "Smtp": { "Host": "localhost", "Port": 25, "From": "nodepilot@localhost", "Username": null, "Password": null },
  "Llm": { "Enabled": false, "ActiveProfileId": "", "Profiles": {} },
  "RestApi": {
    "BlockPrivateNetworks": true,
    "AllowedHosts": [],
    "Proxy": { "Enabled": false, "Address": "", "BypassList": [], "Username": null, "Password": null }
  },
  "Webhook": { "RequireSecret": true },
  "FileSystemOperation": { "RejectTraversal": true },
  "SqlActivity": { "RequireConnectionRef": true },
  "Trigger": { "Database": { "RequireConnectionRef": true } },
  "StartProgram": { "DisallowShellExecute": true },
  "ExternalTrigger": { "ApiKey": "" },
  "Retention": {
    "Executions": { "Enabled": true, "MaxAgeDays": 30, "IntervalMinutes": 60, "BatchSize": 500, "ArchivePath": "{{DATA_PATH_ESCAPED}}\\archive\\executions" },
    "AuditLog":   { "Enabled": true, "MaxAgeDays": 365, "IntervalMinutes": 720, "BatchSize": 1000, "ArchivePath": "{{DATA_PATH_ESCAPED}}\\archive\\audit", "VerifyIntervalMinutes": 1440, "VerifyMaxFilesPerPass": 500 },
    "WorkflowVersions": { "Enabled": true, "MaxVersionsPerWorkflow": 50, "IntervalMinutes": 1440, "BatchSize": 500 },
    "SupportEvents": { "Enabled": true, "MaxAgeDays": 90, "IntervalMinutes": 360 }
  },
  "OpenTelemetry": { "Enabled": false },
  "Swagger": { "DisableInNonDevelopment": true },
  "AllowedHosts": "localhost;127.0.0.1"
}
