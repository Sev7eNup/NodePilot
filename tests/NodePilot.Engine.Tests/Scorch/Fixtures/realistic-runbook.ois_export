    <Enabled datatype="bool">TRUE</Enabled>
    <SourceObject datatype="string">{22222222-0000-0000-0000-00000000000c}</SourceObject>
    <TargetObject datatype="string">{22222222-0000-0000-0000-00000000000d}</TargetObject>
    <Color datatype="string">0</Color>
    <And datatype="bool">FALSE</And>
